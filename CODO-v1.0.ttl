    rdfs:range xsd:string .

dis:clusterCoherenceScore a owl:DatatypeProperty ;
    rdfs:label "coherence score" ;
    rdfs:domain dis:SemanticCluster ;
    rdfs:range xsd:float .

dis:clusterCreatedAt a owl:DatatypeProperty ;
    rdfs:label "created at" ;
    rdfs:domain dis:SemanticCluster ;
    rdfs:range xsd:dateTime .

dis:clusterId a owl:DatatypeProperty ;
    rdfs:label "cluster ID" ;
    rdfs:domain dis:SemanticCluster ;
    rdfs:range xsd:string .

dis:clusterLabel a owl:DatatypeProperty ;
    rdfs:label "cluster label" ;
    rdfs:domain dis:SemanticCluster ;
    rdfs:range xsd:string .

dis:clusterRepresentsNarrative a owl:ObjectProperty ;
    rdfs:label "cluster represents narrative" ;
    rdfs:domain dis:SemanticCluster ;
    rdfs:range dis:Narrative .

dis:clusterSize a owl:DatatypeProperty ;
    rdfs:label "cluster size" ;
    rdfs:domain dis:SemanticCluster ;

    rdfs:domain dis:ManipulationTechnique ;
    rdfs:range xsd:string .

dis:techniqueName a owl:DatatypeProperty ;
    rdfs:label "technique name" ;
    rdfs:domain dis:ManipulationTechnique ;
    rdfs:range xsd:string .

dis:techniqueTacticPhase a owl:DatatypeProperty ;
    rdfs:label "tactic phase" ;
    rdfs:comment "Phase in the influence operation kill chain." ;
    rdfs:domain dis:ManipulationTechnique ;
    rdfs:range xsd:string .

dis:temporalPatternId a owl:DatatypeProperty ;
    rdfs:label "temporal pattern ID" ;
    rdfs:domain dis:TemporalPattern ;
    rdfs:range xsd:string .

dis:tlpClassification a owl:DatatypeProperty ;
    rdfs:label "TLP classification" ;
    rdfs:comment "Traffic Light Protocol: WHITE | GREEN | AMBER | RED." ;
    rdfs:domain dis:Infrastructure ;
    rdfs:range xsd:string .

dis:usesChannel a owl:ObjectProperty ;
    rdfs:label "uses channel" ;
    rdfs:domain dis:Campaign ;
    rdfs:range dis:Channel .

dis:usesInfrastructure a owl:ObjectProperty ;
    rdfs:label "uses infrastructure" ;
    rdfs:domain dis:Campaign ;
    rdfs:range dis:Infrastructure .

dis:usesTechnique a owl:ObjectProperty ;
    rdfs:label "uses technique" ;
    rdfs:comment "The technique(s) an activity employs. DISARM techniques are valid values because disarm:Technique is a subclass of ManipulationTechnique." ;
    rdfs:domain dis:Activity ;
    rdfs:range dis:ManipulationTechnique .

dis:whoisPrivacy a owl:DatatypeProperty ;
    rdfs:label "WHOIS privacy enabled" ;
    rdfs:domain dis:Infrastructure ;
    rdfs:range xsd:boolean .

# ===========================================================================
#  Module D - Consequences and Response
# ===========================================================================

dis:AccountCompromise a owl:Class ;
    rdfs:label "Account Compromise" ;
    rdfs:comment """A security vulnerability in which legitimate high-follower accounts can be
acquired through credential theft, phishing, or purchase, enabling disinformation
dissemination with the credibility of established identities.
Maps directly to DISARM T0091 (Obtain Compromised Account).
Corresponds to Actor.isSockpuppetConfirmed = true on the compromised account.""" ;
    rdfs:subClassOf dis:TechnicalVulnerability .

dis:AlgorithmicAmplification a owl:Class ;
    rdfs:label "Algorithmic Amplification" ;
    rdfs:comment """A platform characteristic where recommendation algorithms preferentially
surface emotionally activating, sensational, or engagement-maximising content,
inadvertently amplifying disinformation beyond organic reach. Corresponds to
Channel.algorithmicAmplification = true and Channel.channelHasRecommendationAlgorithm = true.
Distinct from the DISARM technique T0056 (Purchase Targeted Advertisements):
AlgorithmicAmplification is a structural platform vulnerability, not an actor technique.""" ;
    rdfs:subClassOf dis:TechnicalVulnerability .

dis:ArmedConflict a owl:Class ;
    rdfs:label "Armed Conflict Vulnerability" ;
    rdfs:comment """Heightened susceptibility during active armed conflict or military crisis.
Armed conflict produces information chaos, reduced verification capacity, high fear
and uncertainty, degraded media infrastructure, and strong demand for real-time
information — all conditions that disinformation exploits.
Corresponds to MilitaryConflictEvent and Objective.MilitaryObjective.
Maps to DISARM T0066 (Conduct Symbolic Action) for conflict-period operations.""" ;
    rdfs:subClassOf dis:SituationalVulnerability .

dis:AttitudinalImpact a owl:Class ;
    rdfs:label "Attitudinal Impact" ;
    rdfs:comment "Changes in attitudes or preferences toward persons, institutions, groups, or policies." ;
    rdfs:subClassOf dis:Impact .

dis:AuthorityBias a owl:Class ;
    rdfs:label "Authority Bias" ;
    rdfs:comment """The tendency to attribute greater accuracy and credibility to the opinions
of an authority figure. Disinformation exploiting authority bias uses fake experts
(T0018), impersonation (T0028), and borrowed institutional credibility (T0016).
Source: Cialdini 1984 social influence model.""" ;
    rdfs:subClassOf dis:CognitiveVulnerability .

dis:AvailabilityBias a owl:Class ;
    rdfs:label "Availability Bias" ;
    rdfs:comment """The tendency to overestimate the likelihood or importance of events that are
easily recalled, typically because they are vivid, recent, or emotionally salient.
Disinformation exploits availability bias through high-frequency repetition (T0049
Flood Information Space) and emotionally charged content (T0021 Memes).""" ;
    rdfs:subClassOf dis:CognitiveVulnerability .

dis:BehaviouralImpact a owl:Class ;
    rdfs:label "Behavioural Impact" ;
    rdfs:comment "Observable changes in behaviour — voting patterns, protest participation, purchasing, avoidance, violence." ;
    rdfs:subClassOf dis:Impact .

dis:CognitiveImpact a owl:Class ;
    rdfs:label "Cognitive Impact" ;
    rdfs:comment "Changes in individual or collective beliefs, knowledge states, or information processing heuristics." ;
    rdfs:subClassOf dis:Impact .

dis:CognitiveOverload a owl:Class ;
    rdfs:label "Cognitive Overload" ;
    rdfs:comment """The state in which an individual's working memory capacity is overwhelmed
by the volume, velocity, or complexity of information, reducing their capacity for
critical evaluation. Disinformation deliberately induces cognitive overload through
information flooding (T0049), information pollution (T0063), and rapid narrative
cycling. High-information-volume media environments structurally produce this state.""" ;
    rdfs:subClassOf dis:CognitiveVulnerability .

dis:CognitiveVulnerability a owl:Class ;
    rdfs:label "Cognitive Vulnerability" ;
    rdfs:comment """Individual psychological predispositions that make a person more susceptible
to accepting, sharing, or acting on disinformation. These are not deficits or
pathologies but normal features of human cognition that disinformation is designed
to exploit. Maps to DISARM T0010 (Conduct Psychographic Analysis) and the
psychological mechanisms described in Lewandowsky et al. 2017.""" ;
    rdfs:subClassOf dis:Vulnerability .

dis:ConfirmationBias a owl:Class ;
    rdfs:label "Confirmation Bias" ;
    rdfs:comment """The tendency to search for, interpret, favour, and recall information that
confirms or supports one's prior beliefs. Disinformation exploiting confirmation bias
frames false claims to align with existing worldviews, reducing critical scrutiny.
Maps to DISARM T0003 (Leverage Existing Narratives).""" ;
    rdfs:subClassOf dis:CognitiveVulnerability .

dis:Countermeasure a owl:Class ;
    rdfs:label "Countermeasure" ;
    rdfs:comment "Any detection, disruption, denial, degradation, mitigation or recovery action taken in response to a cognitive operation. Aligned with DISARM Blue through disarmCounterId and with NIST CSF 2.0 through nistCSFFunction." ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module D - Consequences and Response (domain entity or relation)" .

dis:DegradationCountermeasure a owl:Class ;
    rdfs:label "Degradation Countermeasure" ;
    rdfs:comment "Reduce the effectiveness of the operation without fully stopping it (labelling, friction, demotion in feeds)." ;
    rdfs:subClassOf dis:Countermeasure .

dis:DenialCountermeasure a owl:Class ;
    rdfs:label "Denial Countermeasure" ;
    rdfs:comment "Prevent the narrative from reaching its intended audience (takedown, deplatforming, content removal)." ;
    rdfs:subClassOf dis:Countermeasure .

dis:DetectionCountermeasure a owl:Class ;
    rdfs:label "Detection Countermeasure" ;
    rdfs:comment "Identify, monitor, and alert on disinformation activity. Maps to NIST CSF DETECT function." ;
    rdfs:subClassOf dis:Countermeasure .

dis:DetectionEvent a owl:Class ;
    rdfs:label "Detection Event" ;
    rdfs:comment "A system-generated alert or analyst finding flagging suspicious activity." ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module D - Consequences and Response (domain entity or relation)" .

dis:DisruptionCountermeasure a owl:Class ;
    rdfs:label "Disruption Countermeasure" ;
    rdfs:comment "Actively impede the operational capability of a disinformation campaign. Maps to NIST CSF RESPOND." ;
    rdfs:subClassOf dis:Countermeasure .

dis:EconomicCrisis a owl:Class ;
    rdfs:label "Economic Crisis Vulnerability" ;
    rdfs:comment """Heightened susceptibility during periods of economic shock, recession,
hyperinflation, financial crisis, or severe inequality. Economic crises amplify
social grievances, erode institutional trust, create scapegoating dynamics,
and produce receptivity to simple causal narratives.
Corresponds to EconomicEvent and Motivation.EconomicMotivation (of adversaries
who exploit the crisis) and SocialVulnerability.SocialGrievance (of affected audiences).
Maps to DISARM T0074 (Identify Existing Fissures) in economic contexts.""" ;
    rdfs:subClassOf dis:SituationalVulnerability .

dis:EconomicImpact a owl:Class ;
    rdfs:label "Economic Impact" ;
    rdfs:comment "Measurable financial consequences: market movements, reduced investment, currency devaluation, consumer behaviour changes." ;
    rdfs:subClassOf dis:Impact .

dis:EducationCountermeasure a owl:Class ;
    rdfs:label "Education Countermeasure" ;
    rdfs:comment "Media literacy programmes, prebunking curricula, digital resilience training. Longest-term but most durable countermeasure category." ;
    rdfs:subClassOf dis:Countermeasure .

dis:Effect a owl:Class ;
    rdfs:label "Effect" ;
    rdfs:comment """A measured or inferred impact of a disinformation operation on a target
audience. Covers the 'E' (Effect) and 'D' (Degree) dimensions of the ABCDE
framework. Includes belief change, polarisation amplification, institutional
trust erosion, and mobilisation to offline action.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module D - Consequences and Response (domain entity or relation)" .

dis:ElectionPeriod a owl:Class ;
    rdfs:label "Election Period Vulnerability" ;
    rdfs:comment """Heightened susceptibility during electoral campaigns and voting periods.
Election periods produce elevated emotional salience, intense political polarisation,
high-volume information environments, and strong motivation for both domestic and
foreign adversaries to interfere. The EEAS FIMI framework identifies elections as
the single most frequently exploited situational context.
Corresponds to ElectoralEvent and Objective.ElectoralObjective.""" ;
    rdfs:subClassOf dis:SituationalVulnerability .

dis:EmotionalReasoning a owl:Class ;
    rdfs:label "Emotional Reasoning" ;
    rdfs:comment """The tendency to treat one's emotional response to information as evidence for
its truth — 'it feels true, therefore it is true'. Disinformation specifically targets
this vulnerability through high-arousal emotional content (anger, fear, disgust),
corresponding to elevated EmotionAnnotation.angerScore, fearScore and disgustScore.""" ;
    rdfs:subClassOf dis:CognitiveVulnerability .

dis:Harm a owl:Class ;
    rdfs:label "Harm" ;
    rdfs:comment """Subclass of Effect capturing legally and ethically framed harm
outcomes. Carries additional legal category, severity, and DSA regulatory
reporting fields. Maps directly to the AMAS DEMEAN/DEFRAUD/DISINFORM harm
typology and to Wardle & Derakhshan's information disorder harm model.""" ;
    rdfs:subClassOf dis:Effect .

dis:IdentityConflict a owl:Class ;
    rdfs:label "Identity Conflict" ;
    rdfs:comment """A condition in which identity-defining attributes (national, ethnic, religious,
linguistic, or political) are in active tension or contested within or between
communities. Identity conflict activates Haidt MFT loyalty and sanctity foundations,
making communities susceptible to in-group/out-group disinformation framing.
Maps to DISARM T0083 (Identify Target Audience Adversaries) and InGroupBias.""" ;
    rdfs:subClassOf dis:SocialVulnerability .

dis:ImmediateEffect a owl:Class ;
    rdfs:label "Immediate Effect" ;
    rdfs:comment "The first-order, directly observable effect close to exposure (e.g. '12% of exposed users reported believing Claim X'). First stage of the Effect causal chain: ImmediateEffect -> Outcome -> Impact -> Harm." ;
    rdfs:subClassOf dis:Effect .

dis:Impact a owl:Class ;
    rdfs:label "Impact" ;
    rdfs:comment """Measured or estimated consequence of a disinformation operation on its
target system, with explicit measurement methodology and confidence bounds.
Distinct from Effect (broader, including unintended and unmeasured outcomes):
Impact specifically tracks observed, attributable changes.
Implements causal inference requirements for disinformation impact research.
Integrates AMAS three-part harm taxonomy (DEMEAN/DEFRAUD/DISINFORM).""" ;
    rdfs:subClassOf dis:Effect ;
    dis:belongsToModule "Module D - Consequences and Response (domain entity or relation)" .

dis:InGroupBias a owl:Class ;
    rdfs:label "In-Group Bias" ;
    rdfs:comment """The tendency to favour information sourced from or about one's own social,
ethnic, political, or ideological in-group. Disinformation exploiting in-group bias
frames narratives in terms of in-group/out-group conflict, activating loyalty and
authority moral foundations (Haidt MFT). Maps to DISARM T0082 (Identify Wedge Issues)
and T0083 (Identify Target Audience Adversaries).""" ;
    rdfs:subClassOf dis:CognitiveVulnerability .

dis:InformationIsolation a owl:Class ;
    rdfs:label "Information Isolation" ;
    rdfs:comment """A condition in which a community has limited access to diverse, high-quality
information sources — either due to geographic isolation, language barriers,
media ownership concentration, or deliberate censorship. Information isolation
creates data voids (T0080) that disinformation fills.
Corresponds to AudienceSegment.audienceTrustInMainstreamMedia (low) and
Location.locationPressFreedomIndex (low).""" ;
    rdfs:subClassOf dis:SocialVulnerability .

dis:InstitutionalImpact a owl:Class ;
    rdfs:label "Institutional Impact" ;
    rdfs:comment "Measurable change in trust in or perceived legitimacy of institutions (government, media, science, judiciary)." ;
    rdfs:subClassOf dis:Impact .

dis:LegalCountermeasure a owl:Class ;
    rdfs:label "Legal Countermeasure" ;
    rdfs:comment "Regulatory enforcement, judicial action, sanctions, or law enforcement response." ;
    rdfs:subClassOf dis:Countermeasure .

dis:LowInstitutionalTrust a owl:Class ;
    rdfs:label "Low Institutional Trust" ;
    rdfs:comment """A condition in which a significant portion of a community has low confidence
in mainstream institutions — government, media, scientific bodies, judiciary.
Low institutional trust creates receptivity to alternative information sources
and reduces the effectiveness of authoritative corrections and fact-checks.
Maps to DISARM T0069 (Discredit Credible Sources) and Impact.InstitutionalImpact.""" ;
    rdfs:subClassOf dis:SocialVulnerability .

dis:MediaEcosystemImpact a owl:Class ;
    rdfs:label "Media Ecosystem Impact" ;
    rdfs:comment "Changes in media consumption patterns, trust in journalism, or the information environment structure." ;
    rdfs:subClassOf dis:Impact .

dis:MissingProvenance a owl:Class ;
    rdfs:label "Missing Content Provenance" ;
    rdfs:comment """A technical gap in which digital content lacks verifiable origin,
creation timestamp, or chain-of-custody metadata, making it impossible to verify
authenticity or detect manipulation. Addressed by the ITU/ISO/IEC AMAS initiative and
the C2PA content credentials specification. Per ETSI TR 104 159 clause 7.2.2, C2PA and
ISCC provenance signals have documented limitations: they are not universally
implemented (some model providers deliberately omit them), can be stripped by bad
actors, are weakened by routine re-encoding/compression, and their widespread adoption
risks the 'liar's dividend' phenomenon — genuine content being wrongly dismissed as
fake because it lacks provenance metadata, or a person in an authentic but unflattering
recording dishonestly claiming it is synthetic. Corresponds to
ContentItem.contentHash absence and unreliable syntheticContentScore. Exploited by
deepfake campaigns (T0085, T0086).""",
        """A technical gap in which digital content lacks verifiable origin, creation
timestamp, or chain-of-custody metadata, making it impossible to verify authenticity
or detect manipulation. Addressed by the ITU/ISO/IEC AMAS initiative and the C2PA
content credentials specification.
Corresponds to ContentItem.contentHash absence and ContentItem.syntheticContentScore
being unavailable or unreliable. Exploited by deepfake campaigns (T0085, T0086).""" ;
    rdfs:subClassOf dis:TechnicalVulnerability .

dis:NarrativeCountermeasure a owl:Class ;
    rdfs:label "Narrative Countermeasure" ;
    rdfs:comment "Strategic communication, prebunking, debunking, or counter-narrative campaigns. Maps to NIST CSF PROTECT." ;
    rdfs:subClassOf dis:Countermeasure .

dis:NaturalDisaster a owl:Class ;
    rdfs:label "Natural Disaster Vulnerability" ;
    rdfs:comment """Heightened susceptibility immediately before, during, and after natural
disasters (earthquakes, floods, wildfires, storms). Natural disasters disrupt
information infrastructure, displace populations, overwhelm official communications,
and create acute information voids that disinformation fills with attribution
narratives (blame assignment), resource misallocation claims, and panic amplification.
Corresponds to NaturalDisasterEvent.""" ;
    rdfs:subClassOf dis:SituationalVulnerability .

dis:NegativityBias a owl:Class ;
    rdfs:label "Negativity Bias" ;
    rdfs:comment """The tendency to give more attention, weight, and processing resources to
negative information than equivalent positive information. Disinformation exploits
negativity bias through fear appeals (fearAppealScore), threat framing, and
catastrophising. Maps to EmotionAnnotation.fearScore and RhetoricalAnnotation.urgencyScore.""" ;
    rdfs:subClassOf dis:CognitiveVulnerability .

dis:Outcome a owl:Class ;
    rdfs:label "Outcome" ;
    rdfs:comment "An intermediate consequence following from an ImmediateEffect (e.g. 'trust in institution X fell by 4 points among the exposed population'). Second stage of the Effect causal chain." ;
    rdfs:subClassOf dis:Effect .

dis:Polarization a owl:Class ;
    rdfs:label "Societal Polarization" ;
    rdfs:comment """A condition of deep, entrenched ideological, political, or social division
within a community that creates distinct, mutually hostile camps. High polarisation
increases disinformation effectiveness by reducing cross-group information sharing
and increasing in-group echo chamber dynamics. Corresponds to
Topic.polarizationIndex and AudienceSegment.audiencePolarisationIndex.
Maps to DISARM T0074 (Identify Existing Fissures) and T0082 (Identify Wedge Issues).""" ;
    rdfs:subClassOf dis:SocialVulnerability .

dis:PublicHealthEmergency a owl:Class ;
    rdfs:label "Public Health Emergency Vulnerability" ;
    rdfs:comment """Heightened susceptibility during pandemics, outbreaks, or public health crises.
Health emergencies produce high anxiety, rapid information demand that outpaces official
response, distrust of potentially contradictory official guidance, and fertile ground
for conspiracy health narratives.
Corresponds to HealthEmergencyEvent. The COVID-19 infodemic is the canonical example.
Maps to DISARM T0057 (Leverage Conspiracy Theory Narratives) in health contexts.""" ;
    rdfs:subClassOf dis:SituationalVulnerability .

dis:RepetitionEffect a owl:Class ;
    rdfs:label "Repetition Effect (Illusory Truth)" ;
    rdfs:comment """The tendency to believe information is true simply because it has been
encountered repeatedly, independent of its actual veracity. This is the cognitive
basis for the disinformation flooding strategy (T0049). Known as the 'illusory truth
effect' in cognitive psychology. Source: Hasher, Goldstein & Toppino 1977;
Pennycook et al. 2018 (DOI: 10.1037/xge0000465).""" ;
    rdfs:subClassOf dis:CognitiveVulnerability .

dis:SecurityImpact a owl:Class ;
    rdfs:label "Security Impact" ;
    rdfs:comment "Effects on military morale, operational security, civil order, or physical safety of individuals." ;
    rdfs:subClassOf dis:Impact .

dis:SituationalVulnerability a owl:Class ;
    rdfs:label "Situational Vulnerability" ;
    rdfs:comment """Time-bounded contextual conditions that temporarily heighten a community's
susceptibility to disinformation. Unlike cognitive or social vulnerabilities (which
are relatively stable), situational vulnerabilities are event-triggered and time-limited,
corresponding to high-salience Events that adversaries exploit as 'information hooks'.
Maps to DISARM TA08 (Conduct Pump Priming), TA13 (Target Audience Analysis), and
the Event class (Event.eventSalience, Event.emotionalSalienceScore).
Note: SituationalVulnerability instances often co-occur with the corresponding
Event subclass (ElectionPeriod ↔ ElectoralEvent, ArmedConflict ↔ MilitaryConflictEvent).""" ;
    rdfs:subClassOf dis:Vulnerability .

dis:SocialCohesionImpact a owl:Class ;
    rdfs:label "Social Cohesion Impact" ;
    rdfs:comment "Changes in intergroup relations, community solidarity, polarisation levels, or social trust." ;
    rdfs:subClassOf dis:Impact .

dis:SocialGrievance a owl:Class ;
    rdfs:label "Social Grievance" ;
    rdfs:comment """A condition in which a community holds legitimate or perceived grievances
related to historical injustice, economic inequality, political marginalisation,
or cultural suppression. Social grievances are powerful emotional hooks that
disinformation narratives exploit to mobilise anger and resentment.
Maps to DISARM T0003 (Leverage Existing Narratives) and EmotionAnnotation.angerScore.""" ;
    rdfs:subClassOf dis:SocialVulnerability .

dis:SocialVulnerability a owl:Class ;
    rdfs:label "Social Vulnerability" ;
    rdfs:comment """Community-level social fragility conditions that create fertile ground for
disinformation operations. Social vulnerabilities are pre-existing structural
characteristics of a community or society that disinformation exploits and amplifies.
Maps to DISARM TA13 (Target Audience Analysis), T0074 (Identify Existing Fissures),
and the ABCDE Degree dimension (societal receptivity to disinformation spread).""" ;
    rdfs:subClassOf dis:Vulnerability .

dis:TechnicalCountermeasure a owl:Class ;
    rdfs:label "Technical Countermeasure" ;
    rdfs:comment "Platform-level technical interventions: bot detection, content fingerprinting, provenance metadata (C2PA), API access controls." ;
    rdfs:subClassOf dis:Countermeasure .

dis:TechnicalVulnerability a owl:Class ;
    rdfs:label "Technical Vulnerability" ;
    rdfs:comment """Platform, infrastructure, or digital ecosystem weaknesses that enable or
amplify disinformation operations. Technical vulnerabilities may be structural
features of platform design, gaps in moderation capability, or security weaknesses.
Primary source: ENISA Threat Landscape 2024 (infrastructure and platform threats).
Maps to DISARM TA07 (Select Channels and Affordances) and TA15 (Establish Assets).""" ;
    rdfs:subClassOf dis:Vulnerability .

dis:Vulnerability a owl:Class ;
    rdfs:label "Vulnerability" ;
    rdfs:comment """A pre-existing condition or characteristic of an individual, community,
platform, or situational context that increases susceptibility to disinformation
influence. Vulnerability models WHY a particular audience or context is susceptible —
the causal mechanism through which disinformation achieves its Effect — distinct from
AudienceSegment (WHO the audience is) and Impact (WHAT happened as a result).

Four branches:
  CognitiveVulnerability   — individual psychological predispositions (8 leaf classes)
  SocialVulnerability      — community-level social fragility (5 leaf classes)
  TechnicalVulnerability   — platform and infrastructure weaknesses (4 leaf classes)
  SituationalVulnerability — time-bounded contextual amplifiers (5 leaf classes)

Primary sources: Lewandowsky et al. 2017 (DOI:10.1016/j.jarmac.2017.07.008);
Pennycook & Rand 2021 (DOI:10.1016/j.tics.2021.02.007);
DISARM TA13, T0010, T0074, T0080; ENISA ETL 2024; Wardle & Derakhshan 2017.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module D - Consequences and Response (domain entity or relation)" .

dis:WeakPlatformModeration a owl:Class ;
    rdfs:label "Weak Platform Moderation" ;
    rdfs:comment """A platform characteristic where content moderation policies, enforcement
mechanisms, or automated detection systems are insufficient to identify and remove
disinformation at scale. Corresponds to Channel.moderationLevel = NONE or LOW.
Maps to DISARM T0043 (Use Fringe Platform) and T0041 (Use Dark Web Platforms).
Exploited by: inauthentic account networks, bot amplification, coordinated flooding.""" ;
    rdfs:subClassOf dis:TechnicalVulnerability .

dis:campaignDetectedAt a owl:DatatypeProperty ;
    rdfs:label "detected at" ;
    rdfs:domain dis:DetectionEvent ;
    rdfs:range xsd:dateTime .

dis:cognitiveVulnerabilityOCEANCorrelate a owl:DatatypeProperty ;
    rdfs:label "OCEAN personality correlate" ;
    rdfs:comment "Big-Five personality dimension(s) associated with elevated expression of this vulnerability (e.g., ConfirmationBias correlates with high Conscientiousness in partisan contexts)." ;
    rdfs:domain dis:CognitiveVulnerability ;
    rdfs:range xsd:string .

dis:cognitiveVulnerabilityPsychologicalMechanism a owl:DatatypeProperty ;
    rdfs:label "psychological mechanism" ;
    rdfs:comment "Description of the underlying cognitive or psychological mechanism (e.g., heuristic processing, motivated reasoning, dual-process theory)." ;
    rdfs:domain dis:CognitiveVulnerability ;
    rdfs:range xsd:string .

dis:countermeasureActorType a owl:DatatypeProperty ;
    rdfs:label "implementing actor type" ;
    rdfs:comment "Who implements this countermeasure: PLATFORM | GOVERNMENT | CIVIL_SOCIETY | RESEARCHER | INDIVIDUAL | MILITARY | INTERNATIONAL_ORG." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:string .

dis:countermeasureAddressesImpact a owl:ObjectProperty ;
    rdfs:label "addresses impact" ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range dis:Impact ;
    owl:inverseOf dis:impactAddressedByCounter .

dis:countermeasureAddressesNarrative a owl:ObjectProperty ;
    rdfs:label "addresses narrative" ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range dis:Narrative .

dis:countermeasureAppliedToCampaign a owl:ObjectProperty ;
    rdfs:label "applied to campaign" ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range dis:Campaign .

dis:countermeasureAppliedToIncident a owl:ObjectProperty ;
    rdfs:label "applied to incident" ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range dis:Incident .

dis:countermeasureComplementedBy a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "complemented by" ;
    rdfs:comment "Two countermeasures are mutually reinforcing when deployed together." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range dis:Countermeasure .

dis:countermeasureDescription a owl:DatatypeProperty ;
    rdfs:label "countermeasure description" ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:string .

dis:countermeasureEffectivenessScore a owl:DatatypeProperty ;
    rdfs:label "effectiveness score" ;
    rdfs:comment "[0,1] empirically measured or estimated effectiveness of this countermeasure." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:float .

dis:countermeasureEvidenceBase a owl:DatatypeProperty ;
    rdfs:label "evidence base" ;
    rdfs:comment "Summary of empirical evidence for effectiveness (citations, experimental results, field deployments)." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:string .

dis:countermeasureId a owl:DatatypeProperty ;
    rdfs:label "countermeasure ID" ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:string .

dis:countermeasureImplementationCost a owl:DatatypeProperty ;
    rdfs:label "implementation cost" ;
    rdfs:comment "Controlled vocabulary: LOW | MEDIUM | HIGH | VERY_HIGH." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:string .

dis:countermeasureImplementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by" ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range dis:Actor .

dis:countermeasureIsDeployable a owl:DatatypeProperty ;
    rdfs:label "is currently deployable" ;
    rdfs:comment "False for theoretical or future countermeasures not yet operationally available." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:boolean .

dis:countermeasureMitigatesTactic a owl:ObjectProperty ;
    rdfs:label "mitigates DISARM tactic" ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range disarm:Tactic .

dis:countermeasureMitigatesTechnique a owl:ObjectProperty ;
    rdfs:label "mitigates DISARM technique" ;
    rdfs:comment "The DISARM Red technique(s) this countermeasure is designed to address." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range disarm:Technique .

dis:countermeasureName a owl:DatatypeProperty ;
    rdfs:label "countermeasure name" ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:string .

dis:countermeasurePrecedes a owl:ObjectProperty ;
    rdfs:label "countermeasure precedes" ;
    rdfs:comment "Recommended sequencing: this countermeasure should be applied before the target (e.g., Detection before Disruption)." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range dis:Countermeasure .

dis:countermeasureRecommendsForTopic a owl:ObjectProperty ;
    rdfs:label "recommended for topic" ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range dis:Topic .

dis:countermeasureReducesImpact a owl:ObjectProperty ;
    rdfs:label "reduces impact" ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range dis:Impact .

dis:countermeasureReferencesDisarmCounter a owl:ObjectProperty ;
    rdfs:label "references DISARM counter" ;
    rdfs:comment "Explicit alignment link to a DISARM Blue catalogue entry." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range disarm:Counter .

dis:countermeasureScalability a owl:DatatypeProperty ;
    rdfs:label "scalability" ;
    rdfs:comment "Controlled vocabulary: INDIVIDUAL | LOCAL | NATIONAL | REGIONAL | GLOBAL." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:string .

dis:countermeasureSideEffectRisk a owl:DatatypeProperty ;
    rdfs:label "side effect risk" ;
    rdfs:comment "Description of potential unintended consequences: overblocking, chilling effect on free speech, legitimacy costs, Streisand effect." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:string .

dis:countermeasureTargetsAudience a owl:ObjectProperty ;
    rdfs:label "countermeasure targets audience" ;
    rdfs:comment "The audience segment the countermeasure is designed to protect or inoculate." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range dis:AudienceSegment .

dis:countermeasureTimeToEffect a owl:DatatypeProperty ;
    rdfs:label "time to effect" ;
    rdfs:comment "Controlled vocabulary: IMMEDIATE | SHORT_TERM | MEDIUM_TERM | LONG_TERM." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:string .

dis:countermeasureType a owl:DatatypeProperty ;
    rdfs:label "countermeasure type" ;
    rdfs:comment "Controlled vocabulary: DETECTION | DISRUPTION | DENIAL | DEGRADATION | NARRATIVE | LEGAL | TECHNICAL | EDUCATION." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:string .

dis:detectedBy a owl:DatatypeProperty ;
    rdfs:label "detected by" ;
    rdfs:domain dis:DetectionEvent ;
    rdfs:range xsd:string .

dis:detectionConfidence a owl:DatatypeProperty ;
    rdfs:label "confidence" ;
    rdfs:domain dis:DetectionEvent ;
    rdfs:range xsd:float .

dis:detectionEventMapsToTactic a owl:ObjectProperty ;
    rdfs:label "detection event maps to tactic" ;
    rdfs:domain dis:DetectionEvent ;
    rdfs:range disarm:Tactic .

dis:detectionEventMapsToTechnique a owl:ObjectProperty ;
    rdfs:label "detection event maps to technique" ;
    rdfs:comment "A DetectionEvent was triggered by signals matching this DISARM Technique." ;
    rdfs:domain dis:DetectionEvent ;
    rdfs:range disarm:Technique .

dis:detectionId a owl:DatatypeProperty ;
    rdfs:label "detection ID" ;
    rdfs:domain dis:DetectionEvent ;
    rdfs:range xsd:string .

dis:detectionMethod a owl:DatatypeProperty ;
    rdfs:label "detection method" ;
    rdfs:comment "e.g. RULE_BASED | ML_CLASSIFIER | ANALYST_REVIEW | GRAPH_ANOMALY | NLP_SIMILARITY." ;
    rdfs:domain dis:DetectionEvent ;
    rdfs:range xsd:string .

dis:detectionNotes a owl:DatatypeProperty ;
    rdfs:label "notes" ;
    rdfs:domain dis:DetectionEvent ;
    rdfs:range xsd:string .

dis:detectionSeverity a owl:DatatypeProperty ;
    rdfs:label "severity" ;
    rdfs:comment "Controlled vocabulary: LOW | MEDIUM | HIGH | CRITICAL." ;
    rdfs:domain dis:DetectionEvent ;
    rdfs:range xsd:string .

dis:detectionStatus a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:comment "Controlled vocabulary: OPEN | CONFIRMED | DISMISSED | ESCALATED." ;
    rdfs:domain dis:DetectionEvent ;
    rdfs:range xsd:string .

dis:disarmCounterId a owl:DatatypeProperty ;
    rdfs:label "DISARM Blue counter ID" ;
    rdfs:comment "Corresponding DISARM Blue C-code (e.g., 'C00001' for Prebunking) for cross-framework alignment." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:string .

dis:effectConfidence a owl:DatatypeProperty ;
    rdfs:label "confidence" ;
    rdfs:domain dis:Effect ;
    rdfs:range xsd:float .

dis:effectId a owl:DatatypeProperty ;
    rdfs:label "effect ID" ;
    rdfs:domain dis:Effect ;
    rdfs:range xsd:string .

dis:effectMagnitude a owl:DatatypeProperty ;
    rdfs:label "effect magnitude" ;
    rdfs:comment "Estimated magnitude [0,1] of the effect." ;
    rdfs:domain dis:Effect ;
    rdfs:range xsd:float .

dis:effectManifestedAsImpact a owl:ObjectProperty ;
    rdfs:label "effect manifested as impact" ;
    rdfs:comment "Links a broader Effect to its evidenced, measured Impact sub-instance." ;
    rdfs:domain dis:Effect ;
    rdfs:range dis:Impact .

dis:effectMeasurementMethod a owl:DatatypeProperty ;
    rdfs:label "measurement method" ;
    rdfs:comment "How the effect was measured: SURVEY | POLLING | PLATFORM_ANALYTICS | EXPERT_ASSESSMENT | COMPUTATIONAL_MODEL." ;
    rdfs:domain dis:Effect ;
    rdfs:range xsd:string .

dis:effectObservedAt a owl:DatatypeProperty ;
    rdfs:label "observed at" ;
    rdfs:domain dis:Effect ;
    rdfs:range xsd:dateTime .

dis:effectProducedByIncident a owl:ObjectProperty ;
    rdfs:label "produced by incident" ;
    rdfs:comment "Inverse of incidentProducedEffect." ;
    rdfs:domain dis:Effect ;
    rdfs:range dis:Incident .

dis:effectTargetAudience a owl:DatatypeProperty ;
    rdfs:label "target audience" ;
    rdfs:domain dis:Effect ;
    rdfs:range xsd:string .

dis:effectTargetsTopic a owl:ObjectProperty ;
    rdfs:label "effect targets topic" ;
    rdfs:domain dis:Effect ;
    rdfs:range dis:Topic .

dis:effectType a owl:DatatypeProperty ;
    rdfs:label "effect type" ;
    rdfs:comment "Controlled vocabulary: BELIEF_CHANGE | POLARISATION | TRUST_EROSION | BEHAVIOURAL_CHANGE | OFFLINE_MOBILISATION | CHILLING_EFFECT | INSTITUTIONAL_DELEGITIMISATION | DEMEAN | DEFRAUD | DISINFORM." ;
    rdfs:domain dis:Effect ;
    rdfs:range xsd:string ;
    skos:note "DEMEAN | DEFRAUD | DISINFORM correspond to the AMAS three-part harm typology [ITU/ISO/IEC AMAS 2025]." .

dis:falsePositiveProbability a owl:DatatypeProperty ;
    rdfs:label "false positive probability" ;
    rdfs:domain dis:DetectionEvent ;
    rdfs:range xsd:float .

dis:harmAddressedByCountermeasure a owl:ObjectProperty ;
    rdfs:label "addressed by countermeasure" ;
    rdfs:domain dis:Harm ;
    rdfs:range dis:Countermeasure .

dis:harmAffectsActor a owl:ObjectProperty ;
    rdfs:label "harm affects actor" ;
    rdfs:comment "The specific Actor (individual or organisation) harmed." ;
    rdfs:domain dis:Harm ;
    rdfs:range dis:Actor .

dis:harmCategory a owl:DatatypeProperty ;
    rdfs:label "harm category" ;
    rdfs:comment "Top-level AMAS harm category: DEMEAN | DEFRAUD | DISINFORM. Refined by harmSubCategory (ETSI TR 104 159)." ;
    rdfs:domain dis:Harm ;
    rdfs:range xsd:string .

dis:harmId a owl:DatatypeProperty ;
    rdfs:label "harm ID" ;
    rdfs:domain dis:Harm ;
    rdfs:range xsd:string .

dis:harmLegalCategory a owl:DatatypeProperty ;
    rdfs:label "legal category" ;
    rdfs:comment "Controlled vocabulary: DEFAMATORY | INCITEMENT | PRIVACY_VIOLATION | ELECTORAL_INTERFERENCE | HATE_SPEECH | HEALTH_HARM | NONE | UNDER_INVESTIGATION." ;
    rdfs:domain dis:Harm ;
    rdfs:range xsd:string .

dis:harmReportingObligationDSA a owl:DatatypeProperty ;
    rdfs:label "DSA reporting obligation" ;
    rdfs:comment "True if this harm type triggers a reporting or transparency obligation under the EU Digital Services Act." ;
    rdfs:domain dis:Harm ;
    rdfs:range xsd:boolean .

dis:harmSeverity a owl:DatatypeProperty ;
    rdfs:label "harm severity" ;
    rdfs:comment "Controlled vocabulary: LOW | MEDIUM | HIGH | CRITICAL." ;
    rdfs:domain dis:Harm ;
    rdfs:range xsd:string .

dis:harmSourceModality a owl:DatatypeProperty ;
    rdfs:label "harm source modality" ;
    rdfs:comment "Controlled vocabulary (ETSI TR 104 159-informed): TextDeepfake | ImageDeepfake | VideoDeepfake | AudioDeepfake | SyntheticDocument | Multimodal | NonSynthetic." ;
    rdfs:domain dis:Harm ;
    rdfs:range xsd:string .

dis:harmStixIndicatorId a owl:DatatypeProperty ;
    rdfs:label "STIX Indicator ID" ;
    rdfs:comment "STIX 2.1 Indicator object ID representing the observable pattern that signals this harm." ;
    rdfs:domain dis:Harm ;
    rdfs:range xsd:string .

dis:harmSubCategory a owl:DatatypeProperty ;
    rdfs:label "harm sub-category" ;
    rdfs:comment """Second-level controlled vocabulary refining dis:impactHarmCategory
(AMAS: DEMEAN|DEFRAUD|DISINFORM), sourced from ETSI TR 104 159 V1.1.1 (2026-01) Table 1.
Organised under the three top-level AMAS branches:

DEMEAN (Psychological Harm): Sextortion | Defamation | Intimidation | Bullying |
  UnderminingTrust

DEFRAUD (Financial Harm): Extortion | IdentityTheft | InsurancePaymentFraud |
  StockPriceManipulation | BrandDamage | ReputationalDamage

DISINFORM (Societal Harm): NewsMediaManipulation | EconomicStabilityDamage |
  JusticeSystemDamage | ScientificSystemDamage | TrustErosion | DemocracyDamage |
  ElectionManipulation | InternationalRelationsDamage | NationalSecurityDamage

Source: ETSI TR 104 159 V1.1.1 (2026-01), Securing Artificial Intelligence (SAI);
Understanding and Preventing Harm from Generative AI, clause 6.8.1, Table 1.""" ;
    rdfs:domain dis:Harm ;
    rdfs:range xsd:string .

dis:harmTriggeredBy a owl:ObjectProperty ;
    rdfs:label "triggered by" ;
    rdfs:domain dis:Harm ;
    rdfs:range dis:ContentItem .

dis:immediateEffectDescription a owl:DatatypeProperty ;
    rdfs:label "immediate effect description" ;
    rdfs:domain dis:ImmediateEffect ;
    rdfs:range xsd:string .

dis:immediateEffectLeadsToOutcome a owl:ObjectProperty ;
    rdfs:label "immediate effect leads to outcome" ;
    rdfs:domain dis:ImmediateEffect ;
    rdfs:range dis:Outcome .

dis:immediateEffectMagnitude a owl:DatatypeProperty ;
    rdfs:label "immediate effect magnitude" ;
    rdfs:domain dis:ImmediateEffect ;
    rdfs:range xsd:float .

dis:immediateEffectObservedAt a owl:DatatypeProperty ;
    rdfs:label "immediate effect observed at" ;
    rdfs:domain dis:ImmediateEffect ;
    rdfs:range xsd:dateTime .

dis:impactAddressedByCounter a owl:ObjectProperty ;
    rdfs:label "impact addressed by countermeasure" ;
    rdfs:domain dis:Impact ;
    rdfs:range dis:Countermeasure .

dis:impactAffectedPopulationSize a owl:DatatypeProperty ;
    rdfs:label "affected population size" ;
    rdfs:domain dis:Impact ;
    rdfs:range xsd:integer .

dis:impactAffectsAudience a owl:ObjectProperty ;
    rdfs:label "impact affects audience" ;
    rdfs:domain dis:Impact ;
    rdfs:range dis:AudienceSegment .

dis:impactAffectsLocation a owl:ObjectProperty ;
    rdfs:label "impact affects location" ;
    rdfs:domain dis:Impact ;
    rdfs:range dis:Location .

dis:impactAttributedToActor a owl:ObjectProperty ;
    rdfs:label "impact attributed to actor" ;
    rdfs:domain dis:Impact ;
    rdfs:range dis:Actor .

dis:impactDescription a owl:DatatypeProperty ;
    rdfs:label "impact description" ;
    rdfs:domain dis:Impact ;
    rdfs:range xsd:string .

dis:impactDuration a owl:DatatypeProperty ;
    rdfs:label "duration" ;
    rdfs:comment "Controlled vocabulary: TRANSIENT | SHORT_TERM | MEDIUM_TERM | LONG_TERM | PERMANENT." ;
    rdfs:domain dis:Impact ;
    rdfs:range xsd:string .

dis:impactEscalatesToHarm a owl:ObjectProperty ;
    rdfs:label "impact escalates to harm" ;
    rdfs:domain dis:Impact ;
    rdfs:range dis:Harm .

dis:impactHarmCategory a owl:DatatypeProperty ;
    rdfs:label "AMAS harm category" ;
    rdfs:comment "AMAS three-part harm taxonomy: DEMEAN | DEFRAUD | DISINFORM. DEMEAN = harm to reputation or dignity; DEFRAUD = financial or material harm; DISINFORM = harm to beliefs and decision-making." ;
    rdfs:domain dis:Impact ;
    rdfs:range xsd:string ;
    skos:note "Source: ITU/ISO/IEC AI and Multimedia Authenticity Standards (AMAS) Collaboration, 2025." .

dis:impactId a owl:DatatypeProperty ;
    rdfs:label "impact ID" ;
    rdfs:domain dis:Impact ;
    rdfs:range xsd:string .

dis:impactLegalCategory a owl:DatatypeProperty ;
    rdfs:label "legal category" ;
    rdfs:comment "Controlled vocabulary: DEFAMATORY | INCITEMENT | PRIVACY_VIOLATION | ELECTORAL_INTERFERENCE | HATE_SPEECH | NONE | UNDER_INVESTIGATION. Supports DSA regulatory reporting." ;
    rdfs:domain dis:Impact ;
    rdfs:range xsd:string .

dis:impactMagnitude a owl:DatatypeProperty ;
    rdfs:label "impact magnitude" ;
    rdfs:comment "[0,1] normalised severity of the impact." ;
    rdfs:domain dis:Impact ;
    rdfs:range xsd:float .

dis:impactMeasurementConfidence a owl:DatatypeProperty ;
    rdfs:label "measurement confidence" ;
    rdfs:comment "[0,1] confidence in the causal attribution of this impact to the identified campaign." ;
    rdfs:domain dis:Impact ;
    rdfs:range xsd:float .

dis:impactMeasurementMethod a owl:DatatypeProperty ;
    rdfs:label "measurement method" ;
    rdfs:comment "Controlled vocabulary: SURVEY | POLLING | PLATFORM_ANALYTICS | ECONOMETRIC | EXPERT_ASSESSMENT | COMPUTATIONAL_MODEL | EXPERIMENTAL | QUASI_EXPERIMENTAL." ;
    rdfs:domain dis:Impact ;
    rdfs:range xsd:string .

dis:impactObservedAt a owl:DatatypeProperty ;
    rdfs:label "observed at" ;
    rdfs:domain dis:Impact ;
    rdfs:range xsd:dateTime .

dis:impactRelatedToClaim a owl:ObjectProperty ;
    rdfs:label "impact related to claim" ;
    rdfs:domain dis:Impact ;
    rdfs:range dis:Claim .

dis:impactRelatedToNarrative a owl:ObjectProperty ;
    rdfs:label "impact related to narrative" ;
    rdfs:domain dis:Impact ;
    rdfs:range dis:Narrative .

dis:impactReversibility a owl:DatatypeProperty ;
    rdfs:label "reversibility" ;
    rdfs:comment "Controlled vocabulary: FULLY_REVERSIBLE | PARTIALLY_REVERSIBLE | IRREVERSIBLE." ;
    rdfs:domain dis:Impact ;
    rdfs:range xsd:string .

dis:impactType a owl:DatatypeProperty ;
    rdfs:label "impact type" ;
    rdfs:domain dis:Impact ;
    rdfs:range xsd:string .

dis:nistCSFFunction a owl:DatatypeProperty ;
    rdfs:label "NIST CSF 2.0 function" ;
    rdfs:comment "NIST Cybersecurity Framework 2.0 function alignment: IDENTIFY | PROTECT | DETECT | RESPOND | RECOVER | GOVERN." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:string .

dis:nistSP80053ControlId a owl:DatatypeProperty ;
    rdfs:label "NIST SP 800-53 control ID" ;
    rdfs:comment "NIST SP 800-53 Rev. 5 control identifier (e.g., 'SI-8: Spam Protection', 'AT-2: Literacy Training')." ;
    rdfs:domain dis:Countermeasure ;
    rdfs:range xsd:string .

dis:outcomeDescription a owl:DatatypeProperty ;
    rdfs:label "outcome description" ;
    rdfs:domain dis:Outcome ;
    rdfs:range xsd:string .

dis:outcomeDuration a owl:DatatypeProperty ;
    rdfs:label "outcome duration" ;
    rdfs:comment "Controlled vocabulary: TRANSIENT | SHORT_TERM | MEDIUM_TERM | LONG_TERM | PERMANENT." ;
    rdfs:domain dis:Outcome ;
    rdfs:range xsd:string .

dis:outcomeMagnitude a owl:DatatypeProperty ;
    rdfs:label "outcome magnitude" ;
    rdfs:domain dis:Outcome ;
    rdfs:range xsd:float .

dis:outcomeManifestsAsImpact a owl:ObjectProperty ;
    rdfs:label "outcome manifests as impact" ;
    rdfs:domain dis:Outcome ;
    rdfs:range dis:Impact .

dis:outcomeObservedAt a owl:DatatypeProperty ;
    rdfs:label "outcome observed at" ;
    rdfs:domain dis:Outcome ;
    rdfs:range xsd:dateTime .

dis:reviewedAt a owl:DatatypeProperty ;
    rdfs:label "reviewed at" ;
    rdfs:domain dis:DetectionEvent ;
    rdfs:range xsd:dateTime .

dis:reviewedBy a owl:DatatypeProperty ;
    rdfs:label "reviewed by" ;
    rdfs:domain dis:DetectionEvent ;
    rdfs:range xsd:string .

dis:situationalVulnerabilityEndDate a owl:DatatypeProperty ;
    rdfs:label "vulnerability window end" ;
    rdfs:domain dis:SituationalVulnerability ;
    rdfs:range xsd:dateTime .

dis:situationalVulnerabilityInformationDemandMultiplier a owl:DatatypeProperty ;
    rdfs:label "information demand multiplier" ;
    rdfs:comment "Ratio of information-seeking behaviour during this situational vulnerability relative to baseline — a proxy for data void risk." ;
    rdfs:domain dis:SituationalVulnerability ;
    rdfs:range xsd:float .

dis:situationalVulnerabilityIntensityPeak a owl:DatatypeProperty ;
    rdfs:label "intensity peak" ;
    rdfs:comment "Timestamp of maximum vulnerability intensity within the window." ;
    rdfs:domain dis:SituationalVulnerability ;
    rdfs:range xsd:dateTime .

dis:situationalVulnerabilityStartDate a owl:DatatypeProperty ;
    rdfs:label "vulnerability window start" ;
    rdfs:comment "Start of the elevated vulnerability window (e.g., campaign period start, disaster onset)." ;
    rdfs:domain dis:SituationalVulnerability ;
    rdfs:range xsd:dateTime .

dis:situationalVulnerabilityTriggeredByEvent a owl:ObjectProperty ;
    rdfs:label "situational vulnerability triggered by event" ;
    rdfs:comment "Specialised subproperty: a SituationalVulnerability is directly triggered by a specific Event instance (e.g., an ElectionPeriod vulnerability instance is triggered by a specific ElectoralEvent)." ;
    rdfs:domain dis:SituationalVulnerability ;
    rdfs:range dis:Event ;
    rdfs:subPropertyOf dis:vulnerabilityAmplifiedByEvent .

dis:socialVulnerabilityGeographicScope a owl:DatatypeProperty ;
    rdfs:label "geographic scope" ;
    rdfs:comment "ISO 3166-1 code(s) where this social vulnerability has been measured or observed." ;
    rdfs:domain dis:SocialVulnerability ;
    rdfs:range xsd:string .

dis:socialVulnerabilityPolarizationIndex a owl:DatatypeProperty ;
    rdfs:label "polarization index" ;
    rdfs:comment "[0,1] measured or estimated degree of this social vulnerability in the target community. Cross-references AudienceSegment.audiencePolarisationIndex." ;
    rdfs:domain dis:SocialVulnerability ;
    rdfs:range xsd:float .

dis:technicalVulnerabilityAffectedPlatforms a owl:DatatypeProperty ;
    rdfs:label "affected platforms" ;
    rdfs:comment "Semicolon-separated list of platform names where this technical vulnerability is most prevalent." ;
    rdfs:domain dis:TechnicalVulnerability ;
    rdfs:range xsd:string .

dis:technicalVulnerabilityCVSSScore a owl:DatatypeProperty ;
    rdfs:label "CVSS-equivalent score" ;
    rdfs:comment "Common Vulnerability Scoring System-equivalent score [0,10] adapted for information-environment technical vulnerabilities." ;
    rdfs:domain dis:TechnicalVulnerability ;
    rdfs:range xsd:float .

dis:technicalVulnerabilityExploitabilityScore a owl:DatatypeProperty ;
    rdfs:label "exploitability score" ;
    rdfs:comment "[0,1] ease with which an adversary can exploit this technical vulnerability." ;
    rdfs:domain dis:TechnicalVulnerability ;
    rdfs:range xsd:float .

dis:vulnerabilityAffectsAudienceSegment a owl:ObjectProperty ;
    rdfs:label "vulnerability affects audience segment" ;
    rdfs:comment "Inverse of audienceExhibitsVulnerability." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range dis:AudienceSegment ;
    owl:inverseOf dis:audienceExhibitsVulnerability .

dis:vulnerabilityAmplifiedByEvent a owl:ObjectProperty ;
    rdfs:label "vulnerability amplified by event" ;
    rdfs:comment "A Vulnerability (particularly SituationalVulnerability) is triggered or amplified by a real-world Event. For example: ElectionPeriod vulnerability is amplified by ElectoralEvents; ArmedConflict is amplified by MilitaryConflictEvents." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range dis:Event .

dis:vulnerabilityContributesToEffect a owl:ObjectProperty ;
    rdfs:label "vulnerability contributes to effect" ;
    rdfs:comment "Full-chain starting point: Vulnerability -> ImmediateEffect -> Outcome -> Impact -> Harm. Use alongside or instead of the shortcut dis:vulnerabilityContributesToImpact when intermediate stages are observed." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range dis:ImmediateEffect .

dis:vulnerabilityContributesToImpact a owl:ObjectProperty ;
    rdfs:label "vulnerability contributes to impact" ;
    rdfs:comment "Documented shortcut linking a Vulnerability directly to an observed Impact, for cases where the intermediate ImmediateEffect and Outcome stages were not observed. It represents incomplete observation, not an alternative causal theory. Use the full chain (vulnerabilityContributesToEffect, immediateEffectLeadsToOutcome, outcomeManifestsAsImpact, impactEscalatesToHarm) when the stages are observed." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range dis:Impact .

dis:vulnerabilityCorrelatesWithVulnerability a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "vulnerability correlates with" ;
    rdfs:comment "Two vulnerabilities tend to co-occur or amplify each other. For example: Polarization (SocialVulnerability) correlates with InGroupBias (CognitiveVulnerability); LowInstitutionalTrust correlates with ConfirmationBias. Symmetric." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range dis:Vulnerability .

dis:vulnerabilityDescription a owl:DatatypeProperty ;
    rdfs:label "vulnerability description" ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range xsd:string .

dis:vulnerabilityDetectionIndicators a owl:DatatypeProperty ;
    rdfs:label "detection indicators" ;
    rdfs:comment "Observable signals that this vulnerability is being actively exploited in a campaign." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range xsd:string .

dis:vulnerabilityExploitedByTechnique a owl:DatatypeProperty ;
    rdfs:label "exploited by technique (string)" ;
    rdfs:comment "Semicolon-separated DISARM T-codes of techniques that specifically exploit this vulnerability. Use the object property vulnerabilityExploitedByTechniqueLink for structured links." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range xsd:string .

dis:vulnerabilityExploitedByTechniqueLink a owl:ObjectProperty ;
    rdfs:label "vulnerability exploited by technique" ;
    rdfs:comment "Inverse of techniqueExploitsVulnerability: the DISARM technique(s) that specifically exploit this vulnerability." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range disarm:Technique ;
    owl:inverseOf dis:techniqueExploitsVulnerability .

dis:vulnerabilityId a owl:DatatypeProperty ;
    rdfs:label "vulnerability ID" ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range xsd:string .

dis:vulnerabilityLabel a owl:DatatypeProperty ;
    rdfs:label "vulnerability label" ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range xsd:string .

dis:vulnerabilityLocatedIn a owl:ObjectProperty ;
    rdfs:label "social vulnerability located in" ;
    rdfs:comment "A SocialVulnerability has been measured or observed in a specific Location. Enables geographic vulnerability mapping." ;
    rdfs:domain dis:SocialVulnerability ;
    rdfs:range dis:Location .

dis:vulnerabilityMitigatedByCountermeasure a owl:ObjectProperty ;
    rdfs:label "vulnerability mitigated by countermeasure" ;
    rdfs:comment "A Countermeasure that addresses or reduces this Vulnerability. For example: CognitiveOverload is mitigated by EducationCountermeasures (media literacy); WeakPlatformModeration by TechnicalCountermeasures (detection systems) and LegalCountermeasures (DSA enforcement)." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range dis:Countermeasure .

dis:vulnerabilityMitigationDifficulty a owl:DatatypeProperty ;
    rdfs:label "mitigation difficulty" ;
    rdfs:comment "Controlled vocabulary: LOW | MEDIUM | HIGH | VERY_HIGH. Cognitive biases are inherently difficult to mitigate; platform vulnerabilities are more tractable." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range xsd:string .

dis:vulnerabilityPrevalenceEstimate a owl:DatatypeProperty ;
    rdfs:label "prevalence estimate" ;
    rdfs:comment "[0,1] estimated proportion of the target population exhibiting this vulnerability." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range xsd:float .

dis:vulnerabilitySeverityScore a owl:DatatypeProperty ;
    rdfs:label "severity score" ;
    rdfs:comment "[0,1] estimated severity or intensity of this vulnerability in a given context." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range xsd:float .

dis:vulnerabilitySourceReference a owl:DatatypeProperty ;
    rdfs:label "source reference" ;
    rdfs:comment "Scientific or framework reference supporting this vulnerability classification (DOI or URL)." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range xsd:string .

dis:vulnerabilityType a owl:DatatypeProperty ;
    rdfs:label "vulnerability type" ;
    rdfs:comment "Controlled vocabulary: COGNITIVE | SOCIAL | TECHNICAL | SITUATIONAL." ;
    rdfs:domain dis:Vulnerability ;
    rdfs:range xsd:string .

# ===========================================================================
#  Module E - Evidence, Assessment and Context
# ===========================================================================

dis:ActorAssessment a owl:Class ;
    rdfs:label "Actor Assessment" ;
    rdfs:comment "A context-dependent analytical score about an Actor or an Account, such as a coordination, automation or influence score. Scores are recorded here rather than as intrinsic Actor properties because they depend on the data, method, time window and model used." ;
    rdfs:subClassOf dis:Assertion ;
    dis:belongsToModule "Module E - Evidence, Assessment and Context (analytical or evidentiary construct)" .

dis:AffectiveProfile a owl:Class ;
    rdfs:label "Affective Profile" ;
    rdfs:comment "The output of affective analysis applied to a ContentItem. An analytical construct (Module E), not a consequence of an operation. Specialised into SentimentAnnotation, EmotionAnnotation, MoralFoundationAnnotation and RhetoricalAnnotation, because valence, discrete emotion, moral framing and rhetorical signals are produced by different methods and are not interchangeable." ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module E - Evidence, Assessment and Context (analytical or evidentiary construct)" .

dis:Assertion a owl:Class ;
    rdfs:label "Assertion" ;
    rdfs:comment "A reified analytical claim: a proposition about the domain together with who asserts it, the supporting or contradicting evidence, confidence, assessment status and time. Used for attribution, veracity judgements, causal claims and analytical classifications that must not be stored as unconditional facts. FactCheckResult, NetworkPositionAssertion, TopicAssessment and ActorAssessment are specialised assertions." ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module E - Evidence, Assessment and Context (analytical or evidentiary construct)" .

dis:BehaviouralEvidence a owl:Class ;
    rdfs:label "Behavioural Evidence" ;
    rdfs:comment "Observed patterns of behaviour, such as posting rhythms or coordinated activity." ;
    rdfs:subClassOf dis:Evidence .

dis:CityLocation a owl:Class ;
    rdfs:label "City" ;
    rdfs:subClassOf dis:Location .

dis:ContinentLocation a owl:Class ;
    rdfs:label "Continent" ;
    rdfs:subClassOf dis:Location .

dis:CountryLocation a owl:Class ;
    rdfs:label "Country" ;
    rdfs:subClassOf dis:Location .

dis:CulturalEvent a owl:Class ;
    rdfs:label "Cultural Event" ;
    rdfs:comment "A cultural flashpoint, religious holiday, anniversary, or identity-relevant event." ;
    rdfs:subClassOf dis:Event .

dis:DigitalForensicEvidence a owl:Class ;
    rdfs:label "Digital-Forensic Evidence" ;
    rdfs:comment "Technical artefacts: metadata, hashes, registration records, logs." ;
    rdfs:subClassOf dis:Evidence .

dis:DocumentaryEvidence a owl:Class ;
    rdfs:label "Documentary Evidence" ;
    rdfs:comment "Documents, reports, publications or official records." ;
    rdfs:subClassOf dis:Evidence .

dis:EconomicEvent a owl:Class ;
    rdfs:label "Economic Event" ;
    rdfs:comment "A financial crisis, sanctions announcement, major market movement, or trade dispute." ;
    rdfs:subClassOf dis:Event .

dis:ElectoralEvent a owl:Class ;
    rdfs:label "Electoral Event" ;
    rdfs:comment "An election, referendum, or electoral campaign period." ;
    rdfs:subClassOf dis:Event .

dis:EmotionAnnotation a owl:Class ;
    rdfs:label "Emotion Annotation" ;
    rdfs:comment "Discrete emotions following Plutchik's eight basic emotions." ;
    rdfs:subClassOf dis:AffectiveProfile .

dis:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "A real-world event that content references, reacts to, or attempts to exploit." ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module E - Evidence, Assessment and Context (domain entity or relation)" .

dis:Evidence a owl:Class ;
    rdfs:label "Evidence" ;
    rdfs:comment "An item of evidence that supports or contradicts an Assertion, ActorParticipation or ActorRelationship." ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module E - Evidence, Assessment and Context (analytical or evidentiary construct)" .

dis:FactCheckResult a owl:Class ;
    rdfs:label "Fact-Check Result" ;
    rdfs:comment "A verdict issued by a fact-checking organisation regarding a Claim." ;
    rdfs:subClassOf dis:Assertion ;
    dis:belongsToModule "Module E - Evidence, Assessment and Context (analytical or evidentiary construct)" .

dis:HealthEmergencyEvent a owl:Class ;
    rdfs:label "Health Emergency Event" ;
    rdfs:comment "A public health emergency, pandemic, or major disease outbreak." ;
    rdfs:subClassOf dis:Event .

dis:HumanIntelligenceEvidence a owl:Class ;
    rdfs:label "Human-Intelligence Evidence" ;
    rdfs:comment "Information obtained from human sources." ;
    rdfs:subClassOf dis:Evidence .

dis:JudicialEvent a owl:Class ;
    rdfs:label "Judicial Event" ;
    rdfs:comment "A significant trial, court ruling, or judicial decision with broad public impact." ;
    rdfs:subClassOf dis:Event .

dis:LocalityLocation a owl:Class ;
    rdfs:label "Locality" ;
    rdfs:comment "Neighbourhood, district, or other sub-city administrative unit." ;
    rdfs:subClassOf dis:Location .

dis:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A geographic entity (continent, country, region, city or locality) or a virtual location (a platform-defined space). Aligned with ISO 3166, UN M.49 and Wikidata identifiers and informed by the STIX 2.1 Location object." ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module E - Evidence, Assessment and Context (domain entity or relation)" .

dis:MilitaryConflictEvent a owl:Class ;
    rdfs:label "Military Conflict Event" ;
    rdfs:comment "An armed conflict, military operation, or significant military escalation." ;
    rdfs:subClassOf dis:Event .

dis:MoralFoundationAnnotation a owl:Class ;
    rdfs:label "Moral-Foundation Annotation" ;
    rdfs:comment "Moral framing following Moral Foundations Theory (Haidt and Graham)." ;
    rdfs:subClassOf dis:AffectiveProfile .

dis:NaturalDisasterEvent a owl:Class ;
    rdfs:label "Natural Disaster Event" ;
    rdfs:comment "An earthquake, flood, wildfire, pandemic, or other natural or environmental disaster." ;
    rdfs:subClassOf dis:Event .

dis:NetworkEvidence a owl:Class ;
    rdfs:label "Network Evidence" ;
    rdfs:comment "Results of network analysis, such as shared infrastructure or interaction graphs." ;
    rdfs:subClassOf dis:Evidence .

dis:NetworkPositionAssertion a owl:Class ;
    rdfs:label "Network Position Assertion" ;
    rdfs:comment """A reified, evidence-bearing assertion of an Actor's (or ContentItem's or
Channel's) structural position within a specific measured network — kept as an
analytical/contextual vocabulary, NOT an intrinsic Actor subtype, since network
position is empirically derived and network-specific. IMPORTANT DISAMBIGUATION: the
value 'Amplifier' can describe either an operational role assigned via
dis:participationRole (an actor deliberately amplifying content) or a structurally
derived network function recorded here (a node that empirically amplifies signal
regardless of intent). These are kept as distinct properties on distinct classes
precisely to avoid conflating assigned role with measured structural function.""" ;
    rdfs:subClassOf dis:Assertion ;
    dis:belongsToModule "Module E - Evidence, Assessment and Context (analytical or evidentiary construct)" .

dis:PoliticalCrisisEvent a owl:Class ;
    rdfs:label "Political Crisis Event" ;
    rdfs:comment "A governmental crisis, protest movement, coup attempt, or major political scandal." ;
    rdfs:subClassOf dis:Event .

dis:RegionLocation a owl:Class ;
    rdfs:label "Sub-national Region" ;
    rdfs:comment "State, province, oblast, canton, or equivalent administrative division." ;
    rdfs:subClassOf dis:Location .

dis:RhetoricalAnnotation a owl:Class ;
    rdfs:label "Rhetorical Annotation" ;
    rdfs:comment "Rhetorical and manipulative signals such as fear appeals, urgency and out-group hostility." ;
    rdfs:subClassOf dis:AffectiveProfile .

dis:SecurityIncidentEvent a owl:Class ;
    rdfs:label "Security Incident Event" ;
    rdfs:comment "A terrorist attack, cyber incident, assassination, or major crime event." ;
    rdfs:subClassOf dis:Event .

dis:SemanticCluster a owl:Class ;
    rdfs:label "Semantic Cluster" ;
    rdfs:comment "A group of ContentItems identified by embedding-based similarity: the output of a clustering procedure applied to particular data with a particular model at a particular time. An analytical construct (Module E), not a primary information entity like Claim, Narrative or Topic." ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module E - Evidence, Assessment and Context (analytical or evidentiary construct)" .

dis:SentimentAnnotation a owl:Class ;
    rdfs:label "Sentiment Annotation" ;
    rdfs:comment "General valence or polarity of content." ;
    rdfs:subClassOf dis:AffectiveProfile .

dis:SimilarityRelation a owl:Class ;
    rdfs:label "Similarity Relation" ;
    rdfs:comment """Reified similarity assertion between two ContentItem instances.
Stores the similarity score, embedding model, and computation timestamp
on the relation instance rather than on a plain object property.
Use dis:hasSimilarityRelation to link ContentItems to their SimilarityRelation instances.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module E - Evidence, Assessment and Context (analytical or evidentiary construct)" .

dis:SportingEvent a owl:Class ;
    rdfs:label "Sporting Event" ;
    rdfs:comment "A major sporting competition (World Cup, Olympics, etc.) used as a disinformation hook." ;
    rdfs:subClassOf dis:Event .

dis:TopicAssessment a owl:Class ;
    rdfs:label "Topic Assessment" ;
    rdfs:comment "A context-dependent assessment of a Topic, such as its exploitability or polarisation in a given location, audience, event or period, with method, timestamp and confidence. Exploitability and polarisation are not intrinsic properties of a Topic and are recorded only here." ;
    rdfs:subClassOf dis:Assertion ;
    dis:belongsToModule "Module E - Evidence, Assessment and Context (analytical or evidentiary construct)" .

dis:VirtualLocation a owl:Class ;
    rdfs:label "Virtual Location" ;
    rdfs:comment "A platform-defined or cyberspace community with no stable geographic anchoring (e.g., a diaspora Telegram channel, an online subculture community)." ;
    rdfs:subClassOf dis:Location .

dis:actorAssessmentConfidence a owl:DatatypeProperty ;
    rdfs:label "assessment confidence" ;
    rdfs:comment "Confidence in [0,1]." ;
    rdfs:domain dis:ActorAssessment ;
    rdfs:range xsd:float .

dis:actorAssessmentMethod a owl:DatatypeProperty ;
    rdfs:label "assessment method" ;
    rdfs:domain dis:ActorAssessment ;
    rdfs:range xsd:string .

dis:actorAssessmentMetric a owl:DatatypeProperty ;
    rdfs:label "assessment metric" ;
    rdfs:comment "Controlled vocabulary: CoordinatedBehaviour | Automation | Sockpuppet | Influence | Reach | ActivityAnomaly | Other." ;
    rdfs:domain dis:ActorAssessment ;
    rdfs:range xsd:string .

dis:actorAssessmentValue a owl:DatatypeProperty ;
    rdfs:label "assessment value" ;
    rdfs:domain dis:ActorAssessment ;
    rdfs:range xsd:float .

dis:actorAssessmentWindowEnd a owl:DatatypeProperty ;
    rdfs:label "assessment window end" ;
    rdfs:domain dis:ActorAssessment ;
    rdfs:range xsd:dateTime .

dis:actorAssessmentWindowStart a owl:DatatypeProperty ;
    rdfs:label "assessment window start" ;
    rdfs:domain dis:ActorAssessment ;
    rdfs:range xsd:dateTime .

dis:affectiveAnalysedAt a owl:DatatypeProperty ;
    rdfs:label "analysed at" ;
    rdfs:domain dis:AffectiveProfile ;
    rdfs:range xsd:dateTime .

dis:affectiveModelUsed a owl:DatatypeProperty ;
    rdfs:label "model used" ;
    rdfs:domain dis:AffectiveProfile ;
    rdfs:range xsd:string .

dis:affectiveModelVersion a owl:DatatypeProperty ;
    rdfs:label "model version" ;
    rdfs:domain dis:AffectiveProfile ;
    rdfs:range xsd:string .

dis:affectiveProfileId a owl:DatatypeProperty ;
    rdfs:label "affective profile ID" ;
    rdfs:domain dis:AffectiveProfile ;
    rdfs:range xsd:string .

dis:angerScore a owl:DatatypeProperty ;
    rdfs:label "anger score" ;
    rdfs:domain dis:EmotionAnnotation ;
    rdfs:range xsd:float .

dis:anticipationScore a owl:DatatypeProperty ;
    rdfs:label "anticipation score" ;
    rdfs:domain dis:EmotionAnnotation ;
    rdfs:range xsd:float .

dis:assertedAt a owl:DatatypeProperty ;
    rdfs:label "asserted at" ;
    rdfs:domain dis:Assertion ;
    rdfs:range xsd:dateTime .

dis:assertedBy a owl:ObjectProperty ;
    rdfs:label "asserted by" ;
    rdfs:comment "The actor (analyst, organisation, system operator) making the assertion." ;
    rdfs:domain dis:Assertion ;
    rdfs:range dis:Actor .

dis:assertionConfidence a owl:DatatypeProperty ;
    rdfs:label "assertion confidence" ;
    rdfs:comment "Confidence in the assertion, in [0,1]." ;
    rdfs:domain dis:Assertion ;
    rdfs:range xsd:float .

dis:assertionId a owl:DatatypeProperty ;
    rdfs:label "assertion ID" ;
    rdfs:domain dis:Assertion ;
    rdfs:range xsd:string .

dis:assertionLiteralValue a owl:DatatypeProperty ;
    rdfs:label "assertion literal value" ;
    rdfs:comment "The literal value of the asserted proposition, when it is not an entity." ;
    rdfs:domain dis:Assertion ;
    rdfs:range xsd:string .

dis:assertionObject a owl:ObjectProperty ;
    rdfs:label "assertion object" ;
    rdfs:comment "The entity value of the asserted proposition." ;
    rdfs:domain dis:Assertion .

dis:assertionPredicate a owl:DatatypeProperty ;
    rdfs:label "assertion predicate" ;
    rdfs:comment "IRI of the CODO property expressing the asserted relation (e.g. dis:actorControlledBy)." ;
    rdfs:domain dis:Assertion ;
    rdfs:range xsd:anyURI .

dis:assertionSubject a owl:ObjectProperty ;
    rdfs:label "assertion subject" ;
    rdfs:comment "The entity the asserted proposition is about." ;
    rdfs:domain dis:Assertion .

dis:assessedAccount a owl:ObjectProperty ;
    rdfs:label "assessed account" ;
    rdfs:comment "Used for account-level metrics such as Automation and Sockpuppet." ;
    rdfs:domain dis:ActorAssessment ;
    rdfs:range dis:Account .

dis:assessedActor a owl:ObjectProperty ;
    rdfs:label "assessed actor" ;
    rdfs:domain dis:ActorAssessment ;
    rdfs:range dis:Actor .

dis:assessedTopic a owl:ObjectProperty ;
    rdfs:label "assessed topic" ;
    rdfs:domain dis:TopicAssessment ;
    rdfs:range dis:Topic .

dis:assessmentContextAudience a owl:ObjectProperty ;
    rdfs:label "assessment context: audience" ;
    rdfs:domain dis:TopicAssessment ;
    rdfs:range dis:AudienceSegment .

dis:assessmentContextEvent a owl:ObjectProperty ;
    rdfs:label "assessment context: event" ;
    rdfs:domain dis:TopicAssessment ;
    rdfs:range dis:Event .

dis:assessmentContextLocation a owl:ObjectProperty ;
    rdfs:label "assessment context: location" ;
    rdfs:domain dis:TopicAssessment ;
    rdfs:range dis:Location .

dis:assessmentStatus a owl:DatatypeProperty ;
    rdfs:label "assessment status" ;
    rdfs:comment "Controlled vocabulary: Preliminary | Assessed | Confirmed | Disputed | Retracted." ;
    rdfs:domain dis:Assertion ;
    rdfs:range xsd:string .

dis:clusterCentroidVector a owl:DatatypeProperty ;
    rdfs:label "centroid vector" ;

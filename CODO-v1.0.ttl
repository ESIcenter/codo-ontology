dis:fearAppealScore a owl:DatatypeProperty ;
    rdfs:label "fear appeal score" ;
    rdfs:comment "Degree to which the content uses fear as a persuasive mechanism." ;
    rdfs:domain dis:RhetoricalAnnotation ;
    rdfs:range xsd:float .

dis:fearScore a owl:DatatypeProperty ;
    rdfs:label "fear score" ;
    rdfs:domain dis:EmotionAnnotation ;
    rdfs:range xsd:float .

dis:firstExploitationObservedAt a owl:DatatypeProperty ;
    rdfs:label "first exploitation observed at" ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:dateTime .

dis:hateSpeechScore a owl:DatatypeProperty ;
    rdfs:label "hate speech score" ;
    rdfs:domain dis:RhetoricalAnnotation ;
    rdfs:range xsd:float .

dis:isHighProfileEvent a owl:DatatypeProperty ;
    rdfs:label "is high-profile event" ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:boolean .

dis:isOngoingEvent a owl:DatatypeProperty ;
    rdfs:label "is ongoing" ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:boolean .

dis:isoCountryCode a owl:DatatypeProperty ;
    rdfs:label "ISO country code" ;
    rdfs:comment "ISO 3166-1 alpha-2 code (applicable to CountryLocation instances)." ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:string .

dis:isoRegionCode a owl:DatatypeProperty ;
    rdfs:label "ISO region code" ;
    rdfs:comment "ISO 3166-2 sub-national region code (applicable to RegionLocation instances)." ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:string .

dis:joyScore a owl:DatatypeProperty ;
    rdfs:label "joy score" ;
    rdfs:domain dis:EmotionAnnotation ;
    rdfs:range xsd:float .

dis:locationGeoJson a owl:DatatypeProperty ;
    rdfs:label "GeoJSON geometry" ;
    rdfs:comment "GeoJSON polygon or multipolygon boundary string." ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:string .

dis:locationHistoricalDisinfoTargetCount a owl:DatatypeProperty ;
    rdfs:label "historical disinformation target count" ;
    rdfs:comment "Number of known disinformation campaigns that have targeted this location — a proxy for strategic importance to adversaries." ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:integer .

dis:locationId a owl:DatatypeProperty ;
    rdfs:label "location ID" ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:string .

dis:locationInternetPenetrationRate a owl:DatatypeProperty ;
    rdfs:label "internet penetration rate" ;
    rdfs:comment "[0,1] proportion of population with internet access — relevant for estimating reachable audience size." ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:float .

dis:locationLatitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:float .

dis:locationLongitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:float .

dis:locationName a owl:DatatypeProperty ;
    rdfs:label "location name" ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:string .

dis:locationPartOf a owl:ObjectProperty ;
    rdfs:label "location part of" ;
    rdfs:comment "Hierarchical geographic containment (CityLocation partOf CountryLocation, RegionLocation partOf CountryLocation, etc.)." ;
    rdfs:domain dis:Location ;
    rdfs:range dis:Location .

dis:locationPopulation a owl:DatatypeProperty ;
    rdfs:label "population" ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:integer .

dis:locationPressFreedomIndex a owl:DatatypeProperty ;
    rdfs:label "press freedom index" ;
    rdfs:comment "RSF Press Freedom Index score [0,100] — lower scores indicate greater restriction." ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:float .

dis:locationPrimaryLanguage a owl:DatatypeProperty ;
    rdfs:label "primary language" ;
    rdfs:comment "BCP-47 code of the predominant language in this location." ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:string .

dis:locationSocialMediaPenetrationRate a owl:DatatypeProperty ;
    rdfs:label "social media penetration rate" ;
    rdfs:comment "[0,1] proportion of population active on at least one social media platform." ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:float .

dis:locationType a owl:DatatypeProperty ;
    rdfs:label "location type" ;
    rdfs:comment "Controlled vocabulary: CONTINENT | COUNTRY | REGION | CITY | LOCALITY | VIRTUAL." ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:string .

dis:locationWikidataId a owl:DatatypeProperty ;
    rdfs:label "Wikidata location ID" ;
    rdfs:comment "Wikidata entity IRI (e.g., wd:Q472) for knowledge base cross-reference." ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:anyURI .

dis:locationWktPoint a owl:DatatypeProperty ;
    rdfs:label "WKT point" ;
    rdfs:comment "Well-Known Text geometry string (e.g., POINT(23.3219 42.6977))." ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:string .

dis:manipulationTechniqueFlags a owl:DatatypeProperty ;
    rdfs:label "manipulation technique flags" ;
    rdfs:comment "Semicolon-separated detected manipulation techniques (e.g. STRAWMAN; AD_HOMINEM; FALSE_DILEMMA)." ;
    rdfs:domain dis:RhetoricalAnnotation ;
    rdfs:range xsd:string .

dis:moralFoundationAuthority a owl:DatatypeProperty ;
    rdfs:label "moral foundation: authority/subversion" ;
    rdfs:domain dis:MoralFoundationAnnotation ;
    rdfs:range xsd:float .

dis:moralFoundationCare a owl:DatatypeProperty ;
    rdfs:label "moral foundation: care/harm" ;
    rdfs:comment "Haidt moral foundations theory — care/harm axis score [0,1]." ;
    rdfs:domain dis:MoralFoundationAnnotation ;
    rdfs:range xsd:float .

dis:moralFoundationFairness a owl:DatatypeProperty ;
    rdfs:label "moral foundation: fairness/cheating" ;
    rdfs:domain dis:MoralFoundationAnnotation ;
    rdfs:range xsd:float .

dis:moralFoundationLoyalty a owl:DatatypeProperty ;
    rdfs:label "moral foundation: loyalty/betrayal" ;
    rdfs:domain dis:MoralFoundationAnnotation ;
    rdfs:range xsd:float .

dis:moralFoundationSanctity a owl:DatatypeProperty ;
    rdfs:label "moral foundation: sanctity/degradation" ;
    rdfs:domain dis:MoralFoundationAnnotation ;
    rdfs:range xsd:float .

dis:networkPositionConfidence a owl:DatatypeProperty ;
    rdfs:label "confidence" ;
    rdfs:domain dis:NetworkPositionAssertion ;
    rdfs:range xsd:float .

dis:networkPositionMeasuredAt a owl:DatatypeProperty ;
    rdfs:label "measured at" ;
    rdfs:domain dis:NetworkPositionAssertion ;
    rdfs:range xsd:dateTime .

dis:networkPositionMetric a owl:DatatypeProperty ;
    rdfs:label "metric or method" ;
    rdfs:comment "E.g. betweenness centrality, degree centrality, PageRank, eigenvector centrality." ;
    rdfs:domain dis:NetworkPositionAssertion ;
    rdfs:range xsd:string .

dis:networkPositionNetwork a owl:DatatypeProperty ;
    rdfs:label "network identifier" ;
    rdfs:comment "Identifies which network the position was measured in (e.g. 'Telegram coordination network, Feb 2026')." ;
    rdfs:domain dis:NetworkPositionAssertion ;
    rdfs:range xsd:string .

dis:networkPositionRole a owl:DatatypeProperty ;
    rdfs:label "network position role" ;
    rdfs:comment "Controlled vocabulary: Hub | Bridge | Broker | SourceNode | Gatekeeper | PeripheralNode | Authority | Amplifier | SuperSpreader." ;
    rdfs:domain dis:NetworkPositionAssertion ;
    rdfs:range xsd:string .

dis:networkPositionSubject a owl:ObjectProperty ;
    rdfs:label "network position subject" ;
    rdfs:comment "Typically an Actor, but may also be a ContentItem or Channel for content-propagation network analysis." ;
    rdfs:domain dis:NetworkPositionAssertion ;
    rdfs:range dis:CogOpsEntity .

dis:networkPositionValue a owl:DatatypeProperty ;
    rdfs:label "metric value" ;
    rdfs:domain dis:NetworkPositionAssertion ;
    rdfs:range xsd:float .

dis:outgroupHostilityScore a owl:DatatypeProperty ;
    rdfs:label "outgroup hostility score" ;
    rdfs:comment "Score [0,1] for explicit hostility toward a defined out-group." ;
    rdfs:domain dis:RhetoricalAnnotation ;
    rdfs:range xsd:float .

dis:overallPolarity a owl:DatatypeProperty ;
    rdfs:label "overall polarity" ;
    rdfs:comment "Controlled vocabulary: POSITIVE | NEGATIVE | NEUTRAL | MIXED." ;
    rdfs:domain dis:SentimentAnnotation ;
    rdfs:range xsd:string .

dis:polarityScore a owl:DatatypeProperty ;
    rdfs:label "polarity score" ;
    rdfs:comment "Continuous sentiment score normalised to [-1, +1]." ;
    rdfs:domain dis:SentimentAnnotation ;
    rdfs:range xsd:float .

dis:rhetoricIntensity a owl:DatatypeProperty ;
    rdfs:label "rhetoric intensity" ;
    rdfs:domain dis:RhetoricalAnnotation ;
    rdfs:range xsd:float .

dis:sadnessScore a owl:DatatypeProperty ;
    rdfs:label "sadness score" ;
    rdfs:domain dis:EmotionAnnotation ;
    rdfs:range xsd:float .

dis:similarityComputedAt a owl:DatatypeProperty ;
    rdfs:label "computed at" ;
    rdfs:domain dis:SimilarityRelation ;
    rdfs:range xsd:dateTime .

dis:similarityEmbeddingModel a owl:DatatypeProperty ;
    rdfs:label "embedding model" ;
    rdfs:domain dis:SimilarityRelation ;
    rdfs:range xsd:string .

dis:similarityScore a owl:DatatypeProperty ;
    rdfs:label "similarity score" ;
    rdfs:comment "Cosine similarity or other metric [0,1] between the two content items." ;
    rdfs:domain dis:SimilarityRelation ;
    rdfs:range xsd:float .

dis:similaritySourceItem a owl:ObjectProperty ;
    rdfs:label "source item" ;
    rdfs:domain dis:SimilarityRelation ;
    rdfs:range dis:ContentItem .

dis:similarityTargetItem a owl:ObjectProperty ;
    rdfs:label "target item" ;
    rdfs:domain dis:SimilarityRelation ;
    rdfs:range dis:ContentItem .

dis:similarityType a owl:DatatypeProperty ;
    rdfs:label "similarity type" ;
    rdfs:comment "Controlled vocabulary: TEXTUAL | TOPICAL | SEMANTIC | STRUCTURAL | NARRATIVE | COORDINATED." ;
    rdfs:domain dis:SimilarityRelation ;
    rdfs:range xsd:string .

dis:subjectivityScore a owl:DatatypeProperty ;
    rdfs:label "subjectivity score" ;
    rdfs:comment "Score [0,1] for degree of opinion vs. fact." ;
    rdfs:domain dis:SentimentAnnotation ;
    rdfs:range xsd:float .

dis:supportedByEvidence a owl:ObjectProperty ;
    rdfs:label "supported by evidence" ;
    rdfs:domain dis:Assertion ;
    rdfs:range dis:Evidence .

dis:surpriseScore a owl:DatatypeProperty ;
    rdfs:label "surprise score" ;
    rdfs:domain dis:EmotionAnnotation ;
    rdfs:range xsd:float .

dis:targetsSentimentToward a owl:ObjectProperty ;
    rdfs:label "targets sentiment toward" ;
    rdfs:comment "The entity (person, organisation) toward whom the expressed sentiment is directed." ;
    rdfs:domain dis:AffectiveProfile ;
    rdfs:range dis:Actor .

dis:topicAssessedAt a owl:DatatypeProperty ;
    rdfs:label "assessed at" ;
    rdfs:domain dis:TopicAssessment ;
    rdfs:range xsd:dateTime .

dis:topicAssessmentConfidence a owl:DatatypeProperty ;
    rdfs:label "assessment confidence" ;
    rdfs:domain dis:TopicAssessment ;
    rdfs:range xsd:float .

dis:topicAssessmentMethod a owl:DatatypeProperty ;
    rdfs:label "assessment method" ;
    rdfs:domain dis:TopicAssessment ;
    rdfs:range xsd:string .

dis:topicExploitabilityScore a owl:DatatypeProperty ;
    rdfs:label "exploitability score (contextual)" ;
    rdfs:comment "[0,1], scoped to the assessment's context (location/audience/event/time)." ;
    rdfs:domain dis:TopicAssessment ;
    rdfs:range xsd:float .

dis:topicPolarizationIndex a owl:DatatypeProperty ;
    rdfs:label "polarization index (contextual)" ;
    rdfs:domain dis:TopicAssessment ;
    rdfs:range xsd:float .

dis:toxicityScore a owl:DatatypeProperty ;
    rdfs:label "toxicity score" ;
    rdfs:comment "Perspective API-style toxicity score [0,1]." ;
    rdfs:domain dis:RhetoricalAnnotation ;
    rdfs:range xsd:float .

dis:trustScore a owl:DatatypeProperty ;
    rdfs:label "trust score" ;
    rdfs:domain dis:EmotionAnnotation ;
    rdfs:range xsd:float .

dis:unM49Code a owl:DatatypeProperty ;
    rdfs:label "UN M.49 code" ;
    rdfs:comment "UN M.49 numeric geographic classification code for cross-system alignment." ;
    rdfs:domain dis:Location ;
    rdfs:range xsd:integer .

dis:urgencyScore a owl:DatatypeProperty ;
    rdfs:label "urgency score" ;
    rdfs:domain dis:RhetoricalAnnotation ;
    rdfs:range xsd:float .

dis:wikidataEventId a owl:DatatypeProperty ;
    rdfs:label "Wikidata event ID" ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:anyURI .

# ===========================================================================
#  DISARM v1.6 alignment (disarm: namespace)
# ===========================================================================

disarm:Counter a owl:Class ;
    rdfs:label "DISARM Counter" ;
    rdfs:comment "A DISARM Blue countermeasure. The DISARM master data defines 140 countermeasures; CODO includes a representative subset of 10 as named individuals." ;
    rdfs:subClassOf disarm:DISARMEntity .

disarm:DISARMEntity a owl:Class ;
    rdfs:label "DISARM Entity" ;
    rdfs:comment "Root class for all DISARM framework objects." .

disarm:Phase a owl:Class ;
    rdfs:label "DISARM Phase" ;
    rdfs:comment """Highest-level grouping in DISARM. Phases group Tactics into
broad campaign stages: Planning, Preparation, Execute, and Assess.""" ;
    rdfs:subClassOf disarm:DISARMEntity .

disarm:Procedure a owl:Class ;
    rdfs:label "DISARM Procedure" ;
    rdfs:comment """A specific combination of Techniques observed in a real incident,
forming a threat-actor fingerprint.""" ;
    rdfs:subClassOf disarm:DISARMEntity .

disarm:SubTechnique a owl:Class ;
    rdfs:label "DISARM Sub-Technique" ;
    rdfs:comment "A specific implementation of a parent Technique. DISARM v1.6 defines 288 sub-techniques; CODO includes a representative subset of 12. IDs follow the format T-code.NNN (e.g. T0023.002)." ;
    rdfs:subClassOf disarm:Technique .

disarm:Tactic a owl:Class ;
    rdfs:label "DISARM Tactic" ;
    rdfs:comment """Tactical objective — the 'why' of a stage in an influence
operation. 16 tactics in DISARM Red v1.6 (TA01–TA16).""" ;
    rdfs:subClassOf disarm:DISARMEntity .

disarm:Technique a owl:Class ;
    rdfs:label "DISARM Technique" ;
    rdfs:comment "A specific action that achieves a Tactic. DISARM v1.6 defines 103 techniques; CODO includes a representative subset of 76 as named individuals. IDs follow the T-code format (e.g. T0002)." ;
    rdfs:subClassOf disarm:DISARMEntity,
        dis:ManipulationTechnique .

disarm:belongsToPhase a owl:ObjectProperty ;
    rdfs:label "belongs to phase" ;
    rdfs:domain disarm:Tactic ;
    rdfs:range disarm:Phase .

disarm:belongsToTactic a owl:ObjectProperty ;
    rdfs:label "belongs to tactic" ;
    rdfs:comment "Links a Technique (or Sub-Technique) to its parent Tactic." ;
    rdfs:domain disarm:Technique ;
    rdfs:range disarm:Tactic .

disarm:counterActorType a owl:DatatypeProperty ;
    rdfs:label "counter actor type" ;
    rdfs:comment "Who implements this counter: PLATFORM | GOVERNMENT | CIVIL_SOCIETY | RESEARCHER | INDIVIDUAL." ;
    rdfs:domain disarm:Counter ;
    rdfs:range xsd:string .

disarm:counterType a owl:DatatypeProperty ;
    rdfs:label "counter type" ;
    rdfs:comment "DISARM Blue counter category (e.g. DETECT | DISRUPT | DENY | DEGRADE | DECEIVE | DETER)." ;
    rdfs:domain disarm:Counter ;
    rdfs:range xsd:string .

disarm:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:domain disarm:DISARMEntity ;
    rdfs:range xsd:string .

disarm:detectionIndicators a owl:DatatypeProperty ;
    rdfs:label "detection indicators" ;
    rdfs:comment "Observable signals that this technique is being used; semicolon-separated." ;
    rdfs:domain disarm:Technique ;
    rdfs:range xsd:string .

disarm:disarmId a owl:DatatypeProperty ;
    rdfs:label "DISARM ID" ;
    rdfs:comment "DISARM framework identifier (e.g. 'TA02', 'T0023', 'T0023.002', 'C00001')." ;
    rdfs:domain disarm:DISARMEntity ;
    rdfs:range xsd:string .

disarm:disarmVersion a owl:DatatypeProperty ;
    rdfs:label "DISARM version" ;
    rdfs:comment "Version of the DISARM framework this entity belongs to (e.g. '1.6')." ;
    rdfs:domain disarm:DISARMEntity ;
    rdfs:range xsd:string .

disarm:exampleIncidents a owl:DatatypeProperty ;
    rdfs:label "example incidents" ;
    rdfs:comment "Semicolon-separated list of known incident names where this technique was observed." ;
    rdfs:domain disarm:Technique ;
    rdfs:range xsd:string .

disarm:isSubTechnique a owl:DatatypeProperty ;
    rdfs:label "is sub-technique" ;
    rdfs:domain disarm:Technique ;
    rdfs:range xsd:boolean .

disarm:killChainPhase a owl:DatatypeProperty ;
    rdfs:label "kill chain phase" ;
    rdfs:comment "DISARM kill-chain phase name (e.g. 'plan-objectives', 'develop-content')." ;
    rdfs:domain disarm:Technique ;
    rdfs:range xsd:string .

disarm:mitigatedBy a owl:ObjectProperty ;
    rdfs:label "mitigated by" ;
    rdfs:comment "A Technique is mitigated by one or more Blue Team Counters." ;
    rdfs:domain disarm:Technique ;
    rdfs:range disarm:Counter .

disarm:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain disarm:DISARMEntity ;
    rdfs:range xsd:string .

disarm:procedureUsesTechnique a owl:ObjectProperty ;
    rdfs:label "procedure uses technique" ;
    rdfs:domain disarm:Procedure ;
    rdfs:range disarm:Technique .

disarm:sourceUrl a owl:DatatypeProperty ;
    rdfs:label "source URL" ;
    rdfs:comment "Canonical URL for this entity in the DISARMFoundation GitHub." ;
    rdfs:domain disarm:DISARMEntity ;
    rdfs:range xsd:anyURI .

disarm:stixId a owl:DatatypeProperty ;
    rdfs:label "STIX ID" ;
    rdfs:comment "Full STIX 2.1 object ID from the DISARM STIX bundle (e.g. 'attack-pattern--8ab240c2-...')." ;
    rdfs:domain disarm:DISARMEntity ;
    rdfs:range xsd:string .

disarm:subTechniqueOf a owl:ObjectProperty ;
    rdfs:label "sub-technique of" ;
    rdfs:comment "Links a Sub-Technique to its parent Technique." ;
    rdfs:domain disarm:SubTechnique ;
    rdfs:range disarm:Technique .

disarm:tacticallyPrecedes a owl:ObjectProperty ;
    rdfs:label "tactically precedes" ;
    rdfs:comment "Typical ordering in a kill chain: this Tactic precedes the target in campaign progression." ;
    rdfs:domain disarm:Tactic ;
    rdfs:range disarm:Tactic .

disarm:techniqueEnables a owl:ObjectProperty ;
    rdfs:label "technique enables" ;
    rdfs:comment "Use of this technique commonly enables or amplifies the target technique." ;
    rdfs:domain disarm:Technique ;
    rdfs:range disarm:Technique .

disarm:C00001 a disarm:Counter ;
    rdfs:label "C00001 Prebunking" ;
    disarm:counterActorType "CIVIL_SOCIETY" ;
    disarm:counterType "DENY" ;
    disarm:description "Proactively expose audiences to weakened forms of misleading arguments to build psychological resistance." ;
    disarm:disarmId "C00001" ;
    disarm:mitigatedBy disarm:C00001 ;
    disarm:name "Prebunking" .

disarm:C00002 a disarm:Counter ;
    rdfs:label "C00002 Debunking" ;
    disarm:counterActorType "CIVIL_SOCIETY" ;
    disarm:counterType "DENY" ;
    disarm:description "Publish corrections and fact-checks for specific false claims with authoritative sourcing." ;
    disarm:disarmId "C00002" ;
    disarm:name "Debunking" .

disarm:C00010 a disarm:Counter ;
    rdfs:label "C00010 Bot Detection" ;
    disarm:counterActorType "PLATFORM" ;
    disarm:counterType "DETECT" ;
    disarm:description "Deploy automated and manual tools to identify and flag or remove bot accounts." ;
    disarm:disarmId "C00010" ;
    disarm:name "Bot Detection" .

disarm:C00011 a disarm:Counter ;
    rdfs:label "C00011 Coordinated Behaviour Detection" ;
    disarm:counterActorType "PLATFORM" ;
    disarm:counterType "DETECT" ;
    disarm:description "Identify networks of accounts exhibiting synchronised inauthentic behaviour patterns." ;
    disarm:disarmId "C00011" ;
    disarm:name "Coordinated Behaviour Detection" .

disarm:C00020 a disarm:Counter ;
    rdfs:label "C00020 Content Labelling" ;
    disarm:counterActorType "PLATFORM" ;
    disarm:counterType "DISRUPT" ;
    disarm:description "Apply warning labels to disputed or false content to reduce click-through and spread." ;
    disarm:disarmId "C00020" ;
    disarm:name "Content Labelling" .

disarm:C00021 a disarm:Counter ;
    rdfs:label "C00021 Reduce Algorithmic Amplification" ;
    disarm:counterActorType "PLATFORM" ;
    disarm:counterType "DISRUPT" ;
    disarm:description "Modify recommendation algorithms to reduce the viral spread of disinformation content." ;
    disarm:disarmId "C00021" ;
    disarm:name "Reduce Algorithmic Amplification" .

disarm:C00030 a disarm:Counter ;
    rdfs:label "C00030 Media Literacy Education" ;
    disarm:counterActorType "GOVERNMENT" ;
    disarm:counterType "DETER" ;
    disarm:description "Train audiences to critically evaluate information sources and identify manipulation techniques." ;
    disarm:disarmId "C00030" ;
    disarm:name "Media Literacy Education" .

disarm:C00040 a disarm:Counter ;
    rdfs:label "C00040 Takedown Request" ;
    disarm:counterActorType "GOVERNMENT" ;
    disarm:counterType "DENY" ;
    disarm:description "Submit formal requests to platforms or registrars for removal of inauthentic accounts or content." ;
    disarm:disarmId "C00040" ;
    disarm:name "Takedown Request" .

disarm:C00050 a disarm:Counter ;
    rdfs:label "C00050 Threat Intelligence Sharing" ;
    disarm:counterActorType "RESEARCHER" ;
    disarm:counterType "DETECT" ;
    disarm:description "Share TTP indicators and campaign data with other researchers, platforms, and governments." ;
    disarm:disarmId "C00050" ;
    disarm:name "Threat Intelligence Sharing" .

disarm:C00060 a disarm:Counter ;
    rdfs:label "C00060 Strategic Communication" ;
    disarm:counterActorType "GOVERNMENT" ;
    disarm:counterType "DENY" ;
    disarm:description "Deploy positive counter-messaging campaigns to fill the narrative space occupied by disinformation." ;
    disarm:disarmId "C00060" ;
    disarm:name "Strategic Communication" .

disarm:Phase_Assess a disarm:Phase ;
    rdfs:label "Phase: Assess" ;
    disarm:description "Effectiveness measurement and adaptation." ;
    disarm:name "Assess" .

disarm:Phase_Execute a disarm:Phase ;
    rdfs:label "Phase: Execute" ;
    disarm:description "Active delivery, amplification, and manipulation of the information environment." ;
    disarm:name "Execute" .

disarm:Phase_Plan a disarm:Phase ;
    rdfs:label "Phase: Plan" ;
    disarm:description "Strategic and tactical planning prior to campaign execution." ;
    disarm:name "Plan" .

disarm:Phase_Prepare a disarm:Phase ;
    rdfs:label "Phase: Prepare" ;
    disarm:description "Asset creation, content development, and infrastructure staging." ;
    disarm:name "Prepare" .

disarm:T0001 a disarm:Technique ;
    rdfs:label "T0001 Obtain Needed Resources" ;
    disarm:belongsToTactic disarm:TA01 ;
    disarm:description "Acquire funding, personnel, infrastructure, and tools required for the operation." ;
    disarm:disarmId "T0001" ;
    disarm:killChainPhase "plan-strategy" ;
    disarm:name "Obtain Needed Resources" ;
    disarm:sourceUrl <https://raw.githubusercontent.com/DISARMFoundation/DISARMframeworks/main/generated_pages/techniques/T0001.md> .

disarm:T0002 a disarm:Technique ;
    rdfs:label "T0002 Facilitate State Propaganda" ;
    disarm:belongsToTactic disarm:TA02 ;
    disarm:description "Organise citizens around pro-state messaging. Coordinate paid or volunteer groups to push state propaganda." ;
    disarm:disarmId "T0002" ;
    disarm:killChainPhase "plan-objectives" ;
    disarm:name "Facilitate State Propaganda" ;
    disarm:sourceUrl <https://raw.githubusercontent.com/DISARMFoundation/DISARMframeworks/main/generated_pages/techniques/T0002.md> .

disarm:T0003 a disarm:Technique ;
    rdfs:label "T0003 Leverage Existing Narratives" ;
    disarm:belongsToTactic disarm:TA14 ;
    disarm:description "Use or adapt existing narrative themes that form the bedrock of the target audience's worldview." ;
    disarm:disarmId "T0003" ;
    disarm:killChainPhase "develop-narratives" ;
    disarm:name "Leverage Existing Narratives" ;
    disarm:sourceUrl <https://raw.githubusercontent.com/DISARMFoundation/DISARMframeworks/main/generated_pages/techniques/T0003.md> ;
    dis:techniqueExploitsVulnerability dis:ConfirmationBias,
        dis:InGroupBias .

disarm:T0004 a disarm:Technique ;
    rdfs:label "T0004 Develop Competing Narratives" ;
    disarm:belongsToTactic disarm:TA14 ;
    disarm:description "Create new narratives that compete with or undermine existing authoritative accounts of events." ;
    disarm:disarmId "T0004" ;
    disarm:killChainPhase "develop-narratives" ;
    disarm:name "Develop Competing Narratives" ;
    disarm:sourceUrl <https://raw.githubusercontent.com/DISARMFoundation/DISARMframeworks/main/generated_pages/techniques/T0004.md> .

disarm:T0005 a disarm:Technique ;
    rdfs:label "T0005 Cultivate Ignorant Agents" ;
    disarm:belongsToTactic disarm:TA01 ;
    disarm:description "Recruit and use unwitting individuals who believe they are acting independently to spread narratives." ;
    disarm:disarmId "T0005" ;
    disarm:killChainPhase "plan-strategy" ;
    disarm:name "Cultivate Ignorant Agents" ;
    disarm:sourceUrl <https://raw.githubusercontent.com/DISARMFoundation/DISARMframeworks/main/generated_pages/techniques/T0005.md> .

disarm:T0005_001 a disarm:SubTechnique ;
    rdfs:label "T0005.001 Use Willing Individuals" ;
    disarm:description "Recruit individuals who knowingly participate in narrative spreading, typically for financial or ideological reward." ;
    disarm:disarmId "T0005.001" ;
    disarm:isSubTechnique true ;
    disarm:killChainPhase "plan-strategy" ;
    disarm:name "Use Willing Individuals" ;
    disarm:subTechniqueOf disarm:T0005 .

disarm:T0010 a disarm:Technique ;
    rdfs:label "T0010 Conduct Psychographic Analysis" ;
    disarm:belongsToTactic disarm:TA05 ;
    disarm:description "Use psychological profiling data (personality, values, attitudes) to segment and target audiences." ;
    disarm:disarmId "T0010" ;

dis:clusterTriggeredDetection a owl:ObjectProperty ;
    rdfs:label "cluster triggered detection" ;
    rdfs:domain dis:SemanticCluster ;
    rdfs:range dis:DetectionEvent .

dis:clusteringAlgorithm a owl:DatatypeProperty ;
    rdfs:label "clustering algorithm" ;
    rdfs:domain dis:SemanticCluster ;
    rdfs:range xsd:string .

dis:conspiracyInsinuationScore a owl:DatatypeProperty ;
    rdfs:label "conspiracy insinuation score" ;
    rdfs:domain dis:RhetoricalAnnotation ;
    rdfs:range xsd:float .

dis:contentSurgeObserved a owl:DatatypeProperty ;
    rdfs:label "content surge observed" ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:boolean .

dis:contentSurgeTimestamp a owl:DatatypeProperty ;
    rdfs:label "content surge timestamp" ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:dateTime .

dis:contentSurgeVolumeMultiplier a owl:DatatypeProperty ;
    rdfs:label "content surge volume multiplier" ;
    rdfs:comment "Ratio of observed content volume to pre-event baseline during the surge period." ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:float .

dis:contradictedByEvidence a owl:ObjectProperty ;
    rdfs:label "contradicted by evidence" ;
    rdfs:domain dis:Assertion ;
    rdfs:range dis:Evidence .

dis:dehumanizationScore a owl:DatatypeProperty ;
    rdfs:label "dehumanization score" ;
    rdfs:domain dis:RhetoricalAnnotation ;
    rdfs:range xsd:float .

dis:disgustScore a owl:DatatypeProperty ;
    rdfs:label "disgust score" ;
    rdfs:domain dis:EmotionAnnotation ;
    rdfs:range xsd:float .

dis:emotionalSalienceScore a owl:DatatypeProperty ;
    rdfs:label "emotional salience score" ;
    rdfs:comment "Estimated emotional intensity of this event on target audiences [0,1]. High values increase susceptibility to manipulative framing." ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:float .

dis:estimatedAudienceSize a owl:DatatypeProperty ;
    rdfs:label "estimated audience size" ;
    rdfs:comment "Number of people exposed to mainstream media coverage of this event." ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:integer .

dis:eventAffectsAudience a owl:ObjectProperty ;
    rdfs:label "event affects audience" ;
    rdfs:comment "Audience segments for whom this event is particularly salient — these are the communities most at risk of targeted disinformation exploitation." ;
    rdfs:domain dis:Event ;
    rdfs:range dis:AudienceSegment .

dis:eventCountryCode a owl:DatatypeProperty ;
    rdfs:label "event country code" ;
    rdfs:comment "ISO 3166-1 alpha-2 code of the primary country in which the event occurred." ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:string .

dis:eventEndDate a owl:DatatypeProperty ;
    rdfs:label "event end date" ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:dateTime .

dis:eventFollowedBy a owl:ObjectProperty ;
    rdfs:label "event followed by" ;
    rdfs:comment "Temporal sequence: this event is followed by another in a crisis chain." ;
    rdfs:domain dis:Event ;
    rdfs:range dis:Event .

dis:eventId a owl:DatatypeProperty ;
    rdfs:label "event ID" ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:string .

dis:eventLocationGeo a owl:DatatypeProperty ;
    rdfs:label "location geo" ;
    rdfs:comment "WKT POINT or GeoJSON string." ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:string .

dis:eventLocationName a owl:DatatypeProperty ;
    rdfs:label "location name" ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:string .

dis:eventName a owl:DatatypeProperty ;
    rdfs:label "event name" ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:string .

dis:eventOccurredAt a owl:ObjectProperty ;
    rdfs:label "event occurred at" ;
    rdfs:domain dis:Event ;
    rdfs:range dis:Location .

dis:eventSalience a owl:DatatypeProperty ;
    rdfs:label "event salience" ;
    rdfs:comment "Estimated public attention level at event peak [0,1] — higher salience = greater disinformation exploitation risk." ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:float .

dis:eventSentimentVolatility a owl:DatatypeProperty ;
    rdfs:label "event sentiment volatility" ;
    rdfs:comment "Degree [0,1] to which public sentiment is unstable around this event — high volatility amplifies disinformation effectiveness." ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:float .

dis:eventStartDate a owl:DatatypeProperty ;
    rdfs:label "event start date" ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:dateTime .

dis:eventTriggeredIncident a owl:ObjectProperty ;
    rdfs:label "event triggered incident" ;
    rdfs:comment "The FIMI/disinformation incident that this event precipitated or was used to justify." ;
    rdfs:domain dis:Event ;
    rdfs:range dis:Incident .

dis:eventType a owl:DatatypeProperty ;
    rdfs:label "event type" ;
    rdfs:comment "e.g. ELECTION | MILITARY_CONFLICT | NATURAL_DISASTER | POLITICAL_CRISIS | HEALTH_EMERGENCY | SPORTING_EVENT." ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:string .

dis:evidenceCollectedAt a owl:DatatypeProperty ;
    rdfs:label "evidence collected at" ;
    rdfs:domain dis:Evidence ;
    rdfs:range xsd:dateTime .

dis:evidenceDescription a owl:DatatypeProperty ;
    rdfs:label "evidence description" ;
    rdfs:domain dis:Evidence ;
    rdfs:range xsd:string .

dis:evidenceId a owl:DatatypeProperty ;
    rdfs:label "evidence ID" ;
    rdfs:domain dis:Evidence ;
    rdfs:range xsd:string .

dis:evidenceProvenance a owl:DatatypeProperty ;
    rdfs:label "evidence provenance" ;
    rdfs:comment "How and by whom the evidence was obtained, including the tool or dataset where relevant." ;
    rdfs:domain dis:Evidence ;
    rdfs:range xsd:string .

dis:evidenceSourceUrl a owl:DatatypeProperty ;
    rdfs:label "evidence source URL" ;
    rdfs:domain dis:Evidence ;
    rdfs:range xsd:anyURI .

dis:exploitedByKnownCampaigns a owl:DatatypeProperty ;
    rdfs:label "exploited by known campaigns" ;
    rdfs:domain dis:Event ;
    rdfs:range xsd:boolean .

dis:factCheckConfidence a owl:DatatypeProperty ;
    rdfs:label "confidence" ;
    rdfs:domain dis:FactCheckResult ;
    rdfs:range xsd:float .

dis:factCheckId a owl:DatatypeProperty ;
    rdfs:label "fact-check ID" ;
    rdfs:domain dis:FactCheckResult ;
    rdfs:range xsd:string .

dis:factCheckOrganization a owl:DatatypeProperty ;
    rdfs:label "organization" ;
    rdfs:domain dis:FactCheckResult ;
    rdfs:range xsd:string .

dis:factCheckPublishedAt a owl:DatatypeProperty ;
    rdfs:label "published at" ;
    rdfs:domain dis:FactCheckResult ;

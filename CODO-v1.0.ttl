dis:factCheckUrl a owl:DatatypeProperty ;
    rdfs:label "fact-check URL" ;
    rdfs:domain dis:FactCheckResult ;
    rdfs:range xsd:anyURI .

dis:factCheckVerdict a owl:DatatypeProperty ;

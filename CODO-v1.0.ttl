    rdfs:label "keyword list" ;
    rdfs:domain dis:Topic ;
    rdfs:range xsd:string .

dis:topicLabel a owl:DatatypeProperty ;
    rdfs:label "topic label" ;
    rdfs:domain dis:Topic ;
    rdfs:range xsd:string .

dis:topicTargetedByTechnique a owl:ObjectProperty ;
    rdfs:label "topic targeted by technique" ;
    rdfs:comment """Records historically observed exploitation of this topic by a specific
DISARM technique. Enables proactive threat profiling: querying techniques historically
targeting topics semantically similar to a new topic under analysis.
Example: Topic:ElectoralIntegrity dis:topicTargetedByTechnique disarm:T0082 .""" ;
    rdfs:domain dis:Topic ;
    rdfs:range disarm:Technique .

dis:topicallySimilarTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "topically similar to" ;
    rdfs:comment "Topic-model-level similarity." ;
    rdfs:domain dis:ContentItem ;
    rdfs:range dis:ContentItem .

dis:trendingDuring a owl:ObjectProperty ;
    rdfs:label "trending during" ;
    rdfs:domain dis:Topic ;
    rdfs:range dis:Event .

dis:url a owl:DatatypeProperty ;
    rdfs:label "URL" ;
    rdfs:comment "Canonical URL of the content item." ;
    rdfs:domain dis:ContentItem ;
    rdfs:range xsd:anyURI .

dis:usesManipulationTechnique a owl:ObjectProperty ;
    rdfs:label "uses manipulation technique" ;
    rdfs:domain dis:ContentItem ;
    rdfs:range dis:ManipulationTechnique .

dis:verificationConfidence a owl:DatatypeProperty ;
    rdfs:label "verification confidence" ;
    rdfs:domain dis:Claim ;
    rdfs:range xsd:float .

dis:verificationDate a owl:DatatypeProperty ;
    rdfs:label "verification date" ;
    rdfs:domain dis:Claim ;
    rdfs:range xsd:dateTime .

dis:verificationSource a owl:DatatypeProperty ;
    rdfs:label "verification source" ;
    rdfs:domain dis:Claim ;
    rdfs:range xsd:string .

dis:verificationStatus a owl:DatatypeProperty ;
    rdfs:label "verification status" ;
    rdfs:comment "Controlled vocabulary: TRUE | FALSE | MISLEADING | UNVERIFIED | DISPUTED | PARTIALLY_TRUE." ;
    rdfs:domain dis:Claim ;
    rdfs:range xsd:string .

dis:verifiedBy a owl:ObjectProperty ;
    rdfs:label "verified by" ;
    rdfs:domain dis:Claim ;
    rdfs:range dis:FactCheckResult .

dis:viewCount a owl:DatatypeProperty ;
    rdfs:label "view count" ;
    rdfs:domain dis:ContentItem ;
    rdfs:range xsd:integer .

dis:viralityScore a owl:DatatypeProperty ;
    rdfs:label "virality score" ;
    rdfs:comment "Computed virality score normalised to [0,1]." ;
    rdfs:domain dis:ContentItem ;
    rdfs:range xsd:float .

dis:wordCount a owl:DatatypeProperty ;
    rdfs:label "word count" ;
    rdfs:domain dis:ContentItem ;
    rdfs:range xsd:integer .

# ===========================================================================
#  Module B - Actors and Targeting
# ===========================================================================

dis:AIModelContentTool a owl:Class ;
    rdfs:label "AI Model / Content Tool" ;
    rdfs:comment "A model or tool used to generate, modify, or analyse content (generative model, deepfake tool). Links to ManipulationTechnique (DISARM T0085-T0087) and to dis:MissingProvenance." ;
    rdfs:subClassOf dis:OperationalAsset .

dis:Account a owl:Class ;
    rdfs:label "Account" ;
    rdfs:comment """A platform-specific registered digital identity through which an Actor appears
or acts. An Actor may operate multiple Accounts; an Account is operated by one or more
Actors. Explicitly NOT a subclass of Actor — see the Actor/Account separation
established to resolve the identity/manifestation conflation identified in the actor
taxonomy comparative review.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module B - Actors and Targeting (domain entity or relation)" .

dis:Actor a owl:Class ;
    rdfs:label "Actor" ;
    rdfs:comment """Any entity that produces, amplifies, coordinates, or finances
content or campaigns. May be human, automated, or hybrid.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module B - Actors and Targeting (domain entity or relation)" .

dis:ActorParticipation a owl:Class ;
    rdfs:label "Actor Participation" ;
    rdfs:comment """The central bridge class connecting an Actor to a Process, Campaign,
Activity, Countermeasure, or Impact — carrying role, alignment, intentionality,
control, visibility, time, and evidence. 'Defender' and similar labels are NOT
modelled as fixed actor types; they are contextual positions captured here via
dis:alignmentOrPosition. The same Actor can be Countering a campaign in one
participation record and Supporting an influence activity in another.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module B - Actors and Targeting (domain entity or relation)" .

dis:ActorRelationship a owl:Class ;
    rdfs:label "Actor Relationship" ;
    rdfs:comment """Qualified relation for proxy/affiliate/auxiliary/surrogate and other
actor-to-actor relationships. Relations are directional, time-bounded where
appropriate, and evidence-sensitive. This class is retained alongside the eighteen
direct object properties below (dis:actorOwnedBy etc.) — the direct properties support
quick graph-pattern queries; ActorRelationship supports full reification (time,
evidence, confidence) when that detail is available and needed.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module B - Actors and Targeting (domain entity or relation)" .

dis:ArtificialAgent a owl:Class ;
    rdfs:label "Artificial Agent" ;
    rdfs:comment "A potentially autonomous artificial entity meeting an explicit agency threshold. The threshold is not yet defined (open design question). Ordinary bots are OperationalAsset (Bot), not Actor." ;
    rdfs:subClassOf dis:Actor .

dis:AudienceRelationship a owl:Class ;
    rdfs:label "Audience Relationship" ;
    rdfs:comment """Reified relationship between a Campaign, Incident, or ContentItem and an
AudienceSegment, carrying the type of relationship. The audienceRelationshipType
property models the audience lifecycle from intended through affected, enabling
precise impact measurement. The lifecycle progression is:
IntendedAudience → PotentialAudience → ReachedAudience → ExposedAudience
→ EngagedAudience → AffectedAudience.""",
        """Specialisation of dis:TargetingRelation reserved for cases where the
population-scale engagement funnel is meaningful: IntendedAudience → PotentialAudience
→ ReachedAudience → ExposedAudience → EngagedAudience → AffectedAudience (see
dis:audienceRelationshipType). For non-audience targets (an institution, a decision
process, a named individual), use TargetingRelation directly rather than forcing an
audience-funnel interpretation.""" ;
    rdfs:subClassOf dis:TargetingRelation ;
    dis:belongsToModule "Module B - Actors and Targeting (domain entity or relation)" .

dis:AudienceSegment a owl:Class ;
    rdfs:label "Audience Segment" ;
    rdfs:comment """A defined group of individuals sharing demographic, geographic, linguistic,
ideological, professional, religious, or vulnerability attributes, identified as
targets, potential recipients, or affected communities of a disinformation
operation. Formally models the 'D' (Degree) and 'E' (Effect) dimensions of
the ABCDE framework and the microtargeting dimension of DISARM TA05.
The progression from IntendedAudience to AffectedAudience through the
AudienceRelationship lifecycle vocabulary enables operational impact measurement.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module B - Actors and Targeting (domain entity or relation)" .

dis:Bot a owl:Class ;
    rdfs:label "Bot" ;
    rdfs:comment "Automated software acting through a digital identity or interface (e.g. a posting bot). See dis:ArtificialAgent for the deferred autonomous-agent case." ;
    rdfs:subClassOf dis:OperationalAsset .

dis:BotNetwork a owl:Class ;
    rdfs:label "Bot Network" ;
    rdfs:comment "A coordinated set of automated accounts or agents (a botnet). Distinguish from dis:CoordinatedNetwork, which requires evidenced collective agency to qualify as an Actor." ;
    rdfs:subClassOf dis:OperationalAsset .

dis:CoordinatedNetwork a owl:Class ;
    rdfs:label "Coordinated Network" ;
    rdfs:comment "A coordinated set of actors treated as a collective actor only where collective agency is evidenced (open design question). A merely detected coordination pattern is recorded through NetworkPositionAssertion or SimilarityRelation instead." ;
    rdfs:subClassOf dis:Actor .

dis:DataAudienceAsset a owl:Class ;
    rdfs:label "Data / Audience Asset" ;
    rdfs:comment "Data enabling targeting, profiling, or analytics (voter file, audience segment database). Links to AudienceSegment and Vulnerability for targeting analysis." ;
    rdfs:subClassOf dis:OperationalAsset .

dis:DecisionMakerAudience a owl:Class ;
    rdfs:label "Decision Makers" ;
    rdfs:comment "Political, institutional, corporate, or military decision-makers whose beliefs or decisions directly affect policy or operational outcomes." ;
    rdfs:subClassOf dis:AudienceSegment .

dis:DemographicAudience a owl:Class ;
    rdfs:label "Demographic Audience" ;
    rdfs:comment "Audience defined by age cohort, gender, income level, or education." ;
    rdfs:subClassOf dis:AudienceSegment .

dis:DiasporaAudience a owl:Class ;
    rdfs:label "Diaspora Audience" ;
    rdfs:comment "A geographically dispersed community sharing a common national, ethnic, or cultural origin, living outside their homeland. Diaspora communities are frequently targeted by state actors seeking to shape perceptions in their country of origin." ;
    rdfs:subClassOf dis:AudienceSegment .

dis:GeneralPublicAudience a owl:Class ;
    rdfs:label "General Public" ;
    rdfs:comment "The general population without specific defining characteristics." ;
    rdfs:subClassOf dis:AudienceSegment .

dis:GeographicAudience a owl:Class ;
    rdfs:label "Geographic Audience" ;
    rdfs:comment "Audience defined by country, region, city, or administrative boundary." ;
    rdfs:subClassOf dis:AudienceSegment .

dis:GeopoliticalEntity a owl:Class ;
    rdfs:label "Geopolitical Entity" ;
    rdfs:comment "A territorially and politically constituted entity, such as a state or de facto authority, capable of acting directly or through other actors. State involvement of other actors is expressed through stateRelationshipType and ActorRelationship, not through actor subclasses." ;
    rdfs:subClassOf dis:Actor .

dis:IdeologicalAudience a owl:Class ;
    rdfs:label "Ideological Audience" ;
    rdfs:comment "Audience defined by a worldview, belief system, or value framework (broader than partisan political affiliation)." ;
    rdfs:subClassOf dis:AudienceSegment .

dis:InformalCollective a owl:Class ;
    rdfs:label "Informal Collective" ;
    rdfs:comment "A group or community without a fully formalised organisational structure (online community, activist collective, conspiracy community). Ideology or orientation is modelled separately, not as a subtype." ;
    rdfs:subClassOf dis:Actor .

dis:Institution a owl:Class ;
    rdfs:label "Institution" ;
    rdfs:comment "A durable public or international institution able to act through authorised bodies. Treated as a specialisation of Organization; the precise relationship between the two remains an open design question." ;
    rdfs:subClassOf dis:Organization .

dis:LinguisticAudience a owl:Class ;
    rdfs:label "Linguistic Audience" ;
    rdfs:comment "Audience defined by shared language, including language-minority communities." ;
    rdfs:subClassOf dis:AudienceSegment .

dis:MediaAudience a owl:Class ;
    rdfs:label "Media Audience" ;
    rdfs:comment "Journalists, editors, broadcasters, influencers, and content creators who function as secondary amplifiers — when successfully manipulated, they extend disinformation reach into mainstream media ecosystems." ;
    rdfs:subClassOf dis:AudienceSegment .

dis:MilitaryAudience a owl:Class ;
    rdfs:label "Military Audience" ;
    rdfs:comment "Active or reserve military personnel, veterans, or defence community members. Primary target of psychological operations (PSYOP) and morale-degradation campaigns." ;
    rdfs:subClassOf dis:AudienceSegment .

dis:OperationalAsset a owl:Class ;
    rdfs:label "Operational Asset" ;
    rdfs:comment "A technical or organisational asset used to conduct a campaign or activity, deliberately kept out of the Actor hierarchy. Assets are operated or controlled by Actors, not agents in their own right, unless separately classified as ArtificialAgent." ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module B - Actors and Targeting (domain entity or relation)" .

dis:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A formally constituted collective actor, such as a government body, company, NGO, political party or media organisation. Its institutional placement is recorded separately through institutionalSector, not through subclasses." ;
    rdfs:subClassOf dis:Actor .

dis:OrganizationalUnit a owl:Class ;
    rdfs:label "Organizational Unit" ;
    rdfs:comment "A structurally identifiable component of an Organization that can act semi-independently (department, task force, military unit, newsroom). Useful when action is attributable to a unit rather than the whole organisation." ;
    rdfs:subClassOf dis:Organization .

dis:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "An individual human actor (official, journalist, activist, influencer, analyst)." ;
    rdfs:subClassOf dis:Actor .

dis:PoliticalAudience a owl:Class ;
    rdfs:label "Political Audience" ;
    rdfs:comment "Audience defined by political affiliation, party membership, or voting behaviour." ;
    rdfs:subClassOf dis:AudienceSegment .

dis:ProfessionalAudience a owl:Class ;
    rdfs:label "Professional Audience" ;
    rdfs:comment "Audience defined by occupation, professional sector, or organisational affiliation." ;
    rdfs:subClassOf dis:AudienceSegment .

dis:ReligiousAudience a owl:Class ;
    rdfs:label "Religious Audience" ;
    rdfs:comment "Audience defined by faith community, religious denomination, or degree of religiosity." ;
    rdfs:subClassOf dis:AudienceSegment .

dis:SockpuppetAccount a owl:Class ;
    rdfs:label "Sockpuppet Account" ;
    rdfs:comment "An Account deceptively presented as independent or as another identity (e.g. a fake grassroots persona). Not classified as Actor unless evidence supports autonomous agency." ;
    rdfs:subClassOf dis:Account .

dis:TargetingRelation a owl:Class ;
    rdfs:label "Targeting Relation" ;
    rdfs:comment """General reified relation connecting a targeting Actor/Campaign/Activity to a
targeted entity of ANY kind — not audience communities alone. A minister, military
commander, electoral commission, media outlet, political party, government institution,
fact-checking organisation, international organisation, or a system/decision process
can all be the targetedEntity. The Actor (or other) taxonomy tells us WHAT the targeted
entity is; TargetingRelation tells us THAT it is a target in this particular context —
directly parallel to the ActorParticipation pattern. dis:AudienceRelationship is a
specialised subclass of this class, reserved for cases where the population-scale
engagement funnel (Intended/Reached/Exposed/Engaged/Affected) is meaningful.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module B - Actors and Targeting (domain entity or relation)" .

dis:ThreatActorProfile a owl:Class ;
    rdfs:label "Threat Actor Profile" ;
    rdfs:comment """A consolidated profile of a persistent threat actor (individual,
organisation, or state) assembled from multiple observed incidents and campaigns.
Maps to STIX 2.1 ThreatActor SDO and MITRE ATT&CK Group.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module B - Actors and Targeting (domain entity or relation)" .

dis:UnknownActor a owl:Class ;
    rdfs:label "Unknown or Unresolved Actor" ;
    rdfs:comment "A placeholder for an actor whose identity or form has not been established (e.g. an unknown operator behind a campaign). Should be linked to Assertion instances carrying attribution confidence." ;
    rdfs:subClassOf dis:Actor .

dis:VulnerableCommunityAudience a owl:Class ;
    rdfs:label "Vulnerable Community" ;
    rdfs:comment "Communities with elevated susceptibility to manipulation due to social, economic, informational, or psychological vulnerability factors." ;
    rdfs:subClassOf dis:AudienceSegment .

dis:accountAgeDays a owl:DatatypeProperty ;
    rdfs:label "account age (days)" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:integer .

dis:accountCreatedAt a owl:DatatypeProperty ;
    rdfs:label "account created at" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:dateTime .

dis:accountCreationIP a owl:DatatypeProperty ;
    rdfs:label "account creation IP" ;
    rdfs:comment "IP address used at account registration (if available)." ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:string .

dis:accountDisplayName a owl:DatatypeProperty ;
    rdfs:label "display name" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:string .

dis:accountId a owl:DatatypeProperty ;
    rdfs:label "account ID" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:string .

dis:accountImpersonates a owl:ObjectProperty ;
    rdfs:label "account impersonates" ;
    rdfs:comment "The Account falsely presents itself as belonging to this Actor." ;
    rdfs:domain dis:Account ;
    rdfs:range dis:Actor .

dis:accountIsDeleted a owl:DatatypeProperty ;
    rdfs:label "account is deleted" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:boolean .

dis:accountIsVerified a owl:DatatypeProperty ;
    rdfs:label "is platform-verified" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:boolean .

dis:accountOperatedBy a owl:ObjectProperty ;
    rdfs:label "account operated by" ;
    rdfs:domain dis:Account ;
    rdfs:range dis:Actor .

dis:accountOwnedBy a owl:ObjectProperty ;
    rdfs:label "account owned by" ;
    rdfs:domain dis:Account ;
    rdfs:range dis:Actor .

dis:accountPlatformNativeId a owl:DatatypeProperty ;
    rdfs:label "platform-native account ID" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:string .

dis:activityVariance a owl:DatatypeProperty ;
    rdfs:label "activity variance" ;
    rdfs:comment "Statistical variance of inter-post intervals; low variance may indicate automation." ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:float .

dis:actorAffiliatedWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "affiliated with" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:actorAlignedWith a owl:ObjectProperty ;
    rdfs:label "aligned with" ;
    rdfs:comment "Shares or supports an orientation or objective without necessarily being controlled." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:actorCapability a owl:DatatypeProperty ;
    rdfs:label "actor capability" ;
    rdfs:comment "What means or power the actor can employ, distinct from function (what it is mandated or organised to do, actorFunction) and from operational role (what it does in a given operation, participationRole). Controlled vocabulary informed by the Hybrid CoE non-state actor taxonomy and ALERT: Media | Cyber | Financial | Technological | Civil | Military | Intelligence | Criminal | Other. Multiple values allowed." ;
    rdfs:domain dis:Actor ;
    rdfs:range xsd:string .

dis:actorContractedBy a owl:ObjectProperty ;
    rdfs:label "contracted by" ;
    rdfs:comment "Acts under a contractual arrangement." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:actorControlledBy a owl:ObjectProperty ;
    rdfs:label "controlled by" ;
    rdfs:comment "Exercises effective control. Inverse: dis:actorControls." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:actorCoordinatesWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "coordinates with" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:actorCounters a owl:ObjectProperty ;
    rdfs:label "counters" ;
    rdfs:comment "An actor or countermeasure acting to prevent, mitigate, expose, or respond to a Process/Campaign/ContentItem." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:CogOpsEntity .

dis:actorDirectedBy a owl:ObjectProperty ;
    rdfs:label "directed by" ;
    rdfs:comment "Receives strategic or operational direction." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:actorDrivenByMotivation a owl:ObjectProperty ;
    rdfs:label "actor driven by motivation" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Motivation .

dis:actorEmploysTechnique a owl:ObjectProperty ;
    rdfs:label "actor employs technique" ;
    rdfs:comment "An Actor has been observed using this DISARM Technique." ;
    rdfs:domain dis:Actor ;
    rdfs:range disarm:Technique .

dis:actorFunction a owl:DatatypeProperty ;
    rdfs:label "actor function" ;
    rdfs:comment "What the actor is mandated or organised to do: a relatively stable function, distinct from capability (the means it can employ, actorCapability) and from operational role (what it does in a given operation, participationRole). Controlled vocabulary (17 values): F1 PolicyAndStrategy | F2 CoordinationCrisisManagement | F3 IntelligenceCollectionAnalysis | F4 InvestigationLawEnforcement | F5 MilitaryInformationOperations | F6 CybersecurityTechnicalResponse | F7 StrategicCommunication | F8 PublicDiplomacy | F9 JournalismEditorialProduction | F10 PlatformGovernanceModeration | F11 FactCheckingVerification | F12 MediaInformationLiteracy | F13 ResearchMonitoringEvaluation | F14 RegulationOversight | F15 TechnologyForensicSupport | F16 CommunityMobilizationSupport | F17 FinancingResourceProvision." ;
    rdfs:domain dis:Actor ;
    rdfs:range xsd:string .

dis:actorFundedByActor a owl:ObjectProperty ;
    rdfs:label "funded by actor" ;
    rdfs:comment "Distinct from dis:fundedBy (Campaign domain) to avoid a domain clash." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:actorHasNetworkPosition a owl:ObjectProperty ;
    rdfs:label "actor has network position" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:NetworkPositionAssertion .

dis:actorHasObjective a owl:ObjectProperty ;
    rdfs:label "actor has objective" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Objective .

dis:actorHasProfile a owl:ObjectProperty ;
    rdfs:label "actor has profile" ;
    rdfs:comment "Links individual Actor accounts to a consolidated ThreatActorProfile." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:ThreatActorProfile .

dis:actorId a owl:DatatypeProperty ;
    rdfs:label "actor ID" ;
    rdfs:domain dis:Actor ;
    rdfs:range xsd:string .

dis:actorInvestigates a owl:ObjectProperty ;
    rdfs:label "investigates" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:actorLocatedAt a owl:ObjectProperty ;
    rdfs:label "actor located at" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Location .

dis:actorMemberOf a owl:ObjectProperty ;
    rdfs:label "member of" ;
    rdfs:comment "Belongs to a collective entity (Organization or CoordinatedNetwork). Inverse: dis:actorHasMember." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:actorMonitors a owl:ObjectProperty ;
    rdfs:label "monitors" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:actorOperatesAccount a owl:ObjectProperty ;
    rdfs:label "actor operates account" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Account ;
    owl:inverseOf dis:accountOperatedBy .

dis:actorOwnedBy a owl:ObjectProperty ;
    rdfs:label "owned by" ;
    rdfs:comment "Legal or beneficial ownership. Inverse: dis:actorOwns." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:actorPartOfCampaign a owl:ObjectProperty ;
    rdfs:label "actor part of campaign" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Campaign .

dis:actorRegulates a owl:ObjectProperty ;
    rdfs:label "regulates" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:actorSupportedBy a owl:ObjectProperty ;
    rdfs:label "supported by" ;
    rdfs:comment "Receives material, technical, political, or other support." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:actorTriggeredDetection a owl:ObjectProperty ;
    rdfs:label "actor triggered detection" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:DetectionEvent .

dis:actsOnBehalfOf a owl:ObjectProperty ;
    rdfs:label "acts on behalf of" ;
    rdfs:comment "Acts as a representative or agent." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:alignmentOrPosition a owl:DatatypeProperty ;
    rdfs:label "alignment or position" ;
    rdfs:comment "Contextual position of the actor in relation to the activity: Initiating | Supporting | Countering | Targeted | Affected | NeutralIntermediary | UnwittingParticipant | Mixed | Unknown. Replaces any fixed \"defender\" actor type." ;
    rdfs:domain dis:ActorParticipation ;
    rdfs:range xsd:string .

dis:amplifiesContentOfActor a owl:ObjectProperty ;
    rdfs:label "amplifies content of" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:assetControlledBy a owl:ObjectProperty ;
    rdfs:label "asset controlled by" ;
    rdfs:domain dis:OperationalAsset ;
    rdfs:range dis:Actor .

dis:assetDeployedBy a owl:ObjectProperty ;
    rdfs:label "asset deployed by" ;
    rdfs:domain dis:OperationalAsset ;
    rdfs:range dis:Actor .

dis:assetOperatedBy a owl:ObjectProperty ;
    rdfs:label "asset operated by" ;
    rdfs:domain dis:OperationalAsset ;
    rdfs:range dis:Actor .

dis:assetSupportsCampaign a owl:ObjectProperty ;
    rdfs:label "asset supports campaign" ;
    rdfs:domain dis:OperationalAsset ;
    rdfs:range dis:Campaign .

dis:audienceDigitalLiteracyScore a owl:DatatypeProperty ;
    rdfs:label "digital literacy score" ;
    rdfs:comment "[0,1] estimated capacity to critically evaluate digital content — inverse predictor of disinformation susceptibility." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:float .

dis:audienceExhibitsVulnerability a owl:ObjectProperty ;
    rdfs:label "audience exhibits vulnerability" ;
    rdfs:comment "An AudienceSegment exhibits one or more Vulnerability instances that make it susceptible to specific disinformation techniques. This is the primary link from audience characterisation to vulnerability analysis." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range dis:Vulnerability .

dis:audienceExposedToChannel a owl:ObjectProperty ;
    rdfs:label "audience exposed to channel" ;
    rdfs:comment "Channels where this audience has significant presence and exposure." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range dis:Channel .

dis:audienceGeographyString a owl:DatatypeProperty ;
    rdfs:label "geography (string)" ;
    rdfs:comment "ISO 3166-1 or region name — use audienceLocatedIn object property for structured geographic linking." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:string .

dis:audienceId a owl:DatatypeProperty ;
    rdfs:label "audience ID" ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:string .

dis:audienceLabel a owl:DatatypeProperty ;
    rdfs:label "audience label" ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:string .

dis:audienceLanguage a owl:DatatypeProperty ;
    rdfs:label "primary language" ;
    rdfs:comment "BCP-47 code." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:string .

dis:audienceLocatedIn a owl:ObjectProperty ;
    rdfs:label "audience located in" ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range dis:Location .

dis:audienceMediaConsumptionPattern a owl:DatatypeProperty ;
    rdfs:label "media consumption pattern" ;
    rdfs:comment "Controlled vocabulary: SOCIAL_HEAVY | BROADCAST_HEAVY | PRINT_HEAVY | MESSENGER_HEAVY | MIXED." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:string .

dis:audiencePlatformPreferences a owl:DatatypeProperty ;
    rdfs:label "platform preferences" ;
    rdfs:comment "Semicolon-separated list of preferred platforms for this audience segment." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:string .

dis:audiencePolarisationIndex a owl:DatatypeProperty ;
    rdfs:label "polarisation index" ;
    rdfs:comment "[0,1] degree of internal opinion polarisation within this audience." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:float .

dis:audiencePsychographicProfile a owl:DatatypeProperty ;
    rdfs:label "psychographic profile" ;
    rdfs:comment "OCEAN/Big-Five descriptor or custom psychographic profile label." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:string .

dis:audienceReachEstimate a owl:DatatypeProperty ;
    rdfs:label "reach estimate" ;
    rdfs:comment "Number of individuals reachable via channels known to be used by campaigns targeting this segment." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:integer .

dis:audienceRelatedToAudience a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "audience related to audience" ;
    rdfs:comment "Two audience segments overlap significantly in membership." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range dis:AudienceSegment .

dis:audienceRelationshipConfidence a owl:DatatypeProperty ;
    rdfs:label "relationship confidence" ;
    rdfs:comment "Analyst confidence [0,1] in this audience relationship classification." ;
    rdfs:domain dis:AudienceRelationship ;
    rdfs:range xsd:float .

dis:audienceRelationshipMeasurementMethod a owl:DatatypeProperty ;
    rdfs:label "measurement method" ;
    rdfs:comment "How the relationship was determined: PLATFORM_ANALYTICS | SURVEY | EXPERT_ASSESSMENT | COMPUTATIONAL_MODEL." ;
    rdfs:domain dis:AudienceRelationship ;
    rdfs:range xsd:string .

dis:audienceRelationshipStageOrder a owl:DatatypeProperty ;
    rdfs:label "audience lifecycle stage order" ;
    rdfs:comment "Ordinal of the lifecycle stage, for sorting: 1 IntendedAudience, 2 PotentialAudience, 3 ReachedAudience, 4 ExposedAudience, 5 EngagedAudience, 6 AffectedAudience." ;
    rdfs:domain dis:AudienceRelationship ;
    rdfs:range xsd:integer .

dis:audienceRelationshipType a owl:DatatypeProperty ;
    rdfs:label "audience relationship type" ;
    rdfs:comment """Controlled vocabulary for the audience engagement lifecycle:
  IntendedAudience   — audience the adversary planned to target
  PotentialAudience  — audience reachable given channel characteristics
  ReachedAudience    — audience that received at least one impression
  ExposedAudience    — audience that consumed content at sufficient depth
  EngagedAudience    — audience that actively interacted (liked/shared/commented)
  AffectedAudience   — audience that demonstrably changed beliefs or behaviour""" ;
    rdfs:domain dis:AudienceRelationship ;
    rdfs:range xsd:string .

dis:audienceSizeEstimate a owl:DatatypeProperty ;
    rdfs:label "size estimate" ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:integer .

dis:audienceTrustInMainstreamMedia a owl:DatatypeProperty ;
    rdfs:label "trust in mainstream media" ;
    rdfs:comment "[0,1] average trust level in mainstream media — low trust increases vulnerability to alternative information sources." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:float .

dis:audienceType a owl:DatatypeProperty ;
    rdfs:label "audience type" ;
    rdfs:comment "Controlled vocabulary matching subclass names." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:string .

dis:audienceVulnerabilityScore a owl:DatatypeProperty ;
    rdfs:label "vulnerability score" ;
    rdfs:comment "[0,1] estimated susceptibility to disinformation manipulation." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range xsd:float .

dis:audienceVulnerableToTechnique a owl:ObjectProperty ;
    rdfs:label "audience vulnerable to technique" ;
    rdfs:comment "DISARM techniques historically observed to be effective against this audience segment (e.g., T0010 Psychographic Analysis, T0058 Targeted Advertising)." ;
    rdfs:domain dis:AudienceSegment ;
    rdfs:range disarm:Technique .

dis:avatarChangeCount a owl:DatatypeProperty ;
    rdfs:label "avatar change count" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:integer .

dis:biographyText a owl:DatatypeProperty ;
    rdfs:label "biography text" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:string .

dis:crossPlatformId a owl:DatatypeProperty ;
    rdfs:label "cross-platform ID" ;
    rdfs:comment "Internal ID linking this account to the same real-world actor on other platforms." ;
    rdfs:domain dis:Actor ;
    rdfs:range xsd:string .

dis:dataAssetUsedInTargeting a owl:ObjectProperty ;
    rdfs:label "data asset used in targeting" ;
    rdfs:domain dis:DataAudienceAsset ;
    rdfs:range dis:AudienceSegment .

dis:displayName a owl:DatatypeProperty ;
    rdfs:label "display name" ;
    rdfs:domain dis:Actor ;
    rdfs:range xsd:string .

dis:emailDomain a owl:DatatypeProperty ;
    rdfs:label "email domain" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:string .

dis:exhibitsTemporalPattern a owl:ObjectProperty ;
    rdfs:label "exhibits temporal pattern" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:TemporalPattern .

dis:followerCount a owl:DatatypeProperty ;
    rdfs:label "follower count" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:integer .

dis:followingCount a owl:DatatypeProperty ;
    rdfs:label "following count" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:integer .

dis:institutionalSector a owl:DatatypeProperty ;
    rdfs:label "institutional sector" ;
    rdfs:comment "Institutional placement of an actor (23 values): S1 ExecutiveGovernmentCentralCoordination | S2 ForeignAffairsDiplomacy | S3 DefenseArmedForces | S4 IntelligenceCounterintelligence | S5 InteriorPolicingSecurity | S6 JusticeLawEnforcement | S7 EducationCulture | S8 ElectoralAdministration | S9 RegulationOversight | S10 CybersecurityDigitalGovernance | S11 StrategicPublicCommunication | S12 SpecializedCounterDisinformationHybridThreat | S13 PoliticalOrganizationsCampaigns | S14 MediaJournalism | S15 OnlinePlatforms | S16 TechnologyTelecommunications | S17 AdvertisingPRDataAnalytics | S18 CivilSocietyVolunteerSector | S19 AcademiaResearchThinkTanks | S20 ReligiousCommunityOrganizations | S21 CommercialOtherPrivateSector | S22 InternationalMultinationalOrganizations | S23 OtherUnknownSector. Defender-side categories informed by Tagarev (2026), https://doi.org/10.3389/fpos.2026.1897504. Sector does not imply alignment, intent or role." ;
    rdfs:domain dis:Actor ;
    rdfs:range xsd:string .

dis:isAnonymous a owl:DatatypeProperty ;
    rdfs:label "is anonymous" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:boolean .

dis:isSuspended a owl:DatatypeProperty ;
    rdfs:label "is suspended" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:boolean .

dis:languagesUsed a owl:DatatypeProperty ;
    rdfs:label "languages used" ;
    rdfs:comment "Semicolon-separated list of BCP-47 language codes observed in this actor's posts." ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:string .

dis:lastActiveAt a owl:DatatypeProperty ;
    rdfs:label "last active at" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:dateTime .

dis:linkedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "linked to" ;
    rdfs:comment "Actors share infrastructure, posting patterns, or other signals suggesting a connection." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:locationClaimed a owl:DatatypeProperty ;
    rdfs:label "location claimed" ;
    rdfs:comment "Location as stated in the actor's profile." ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:string .

dis:masqueradesAs a owl:ObjectProperty ;
    rdfs:label "masquerades as" ;
    rdfs:comment "This Actor is impersonating the referenced Actor." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:organizationalForm a owl:DatatypeProperty ;
    rdfs:label "organizational form" ;
    rdfs:comment "Controlled vocabulary: TrollFarm | ContentFarm | ShellCompany | FrontOrganization | GenuineOrganization | Unknown. Separates organisational form from institutional sector and from operational role." ;
    rdfs:domain dis:Organization ;
    rdfs:range xsd:string .

dis:participatingActor a owl:ObjectProperty ;
    rdfs:label "participating actor" ;
    rdfs:comment "Exactly one actor per participation record." ;
    rdfs:domain dis:ActorParticipation ;
    rdfs:range dis:Actor .

dis:participationAssertedBy a owl:ObjectProperty ;
    rdfs:label "participation asserted by" ;
    rdfs:comment "Identifies who made the participation assertion — essential for contested claims (e.g. a research organisation attributing coordinated behaviour)." ;
    rdfs:domain dis:ActorParticipation ;
    rdfs:range dis:Actor .

dis:participationAttributionStatus a owl:DatatypeProperty ;
    rdfs:label "attribution status" ;
    rdfs:comment "Controlled vocabulary: Alleged | Assessed | Confirmed | Disputed | Unresolved." ;
    rdfs:domain dis:ActorParticipation ;
    rdfs:range xsd:string .

dis:participationConfidenceLevel a owl:DatatypeProperty ;
    rdfs:label "confidence level" ;
    rdfs:comment "[0,1] confidence in this participation assertion. Prefer explicit provenance via dis:participationSupportedByEvidence over a bare probability where possible." ;
    rdfs:domain dis:ActorParticipation ;
    rdfs:range xsd:float .

dis:participationDegreeOfControl a owl:DatatypeProperty ;
    rdfs:label "degree of control" ;
    rdfs:comment "Controlled vocabulary: Direct | Indirect | Partial | None | Unknown. Often paired with ActorRelationship control relations (dis:actorControlledBy)." ;
    rdfs:domain dis:ActorParticipation ;
    rdfs:range xsd:string .

dis:participationEndTime a owl:DatatypeProperty ;
    rdfs:label "participation end time" ;
    rdfs:domain dis:ActorParticipation ;
    rdfs:range xsd:dateTime .

dis:participationIntentionality a owl:DatatypeProperty ;
    rdfs:label "intentionality" ;
    rdfs:comment "Controlled vocabulary: Deliberate | Knowing | Reckless | Opportunistic | Unwitting | Automated | Unknown. Attaches to the participation, not to the actor generally — the same actor may act deliberately in one context and unwittingly in another." ;
    rdfs:domain dis:ActorParticipation ;
    rdfs:range xsd:string .

dis:participationRelatedEntity a owl:ObjectProperty ;
    rdfs:label "related entity" ;
    rdfs:comment "The Process/Campaign/Activity/Countermeasure/ContentItem/Impact that is the context of participation. One principal context; links to additional contexts are permitted." ;
    rdfs:domain dis:ActorParticipation ;
    rdfs:range dis:CogOpsEntity .

dis:participationRole a owl:DatatypeProperty ;
    rdfs:label "participation role" ;
    rdfs:comment "Operational role of the actor in this participation context (21 values): Sponsor | Director | Coordinator | Funder | Producer | Operator | Distributor | Amplifier | InfluencerPersuader | IntermediaryGatekeeper | InfrastructureProvider | Enabler | Beneficiary | Monitor | Analyst | Investigator | VerifierFactChecker | Responder | RegulatorEnforcer | EducatorResilienceBuilder | EvaluatorAuditor. Contextual: the same actor may hold different roles in different operations. Being targeted is represented through TargetingRelation, and alignment through alignmentOrPosition. A measured network position (e.g. a structural amplifier) is recorded through NetworkPositionAssertion, not here." ;
    rdfs:domain dis:ActorParticipation ;
    rdfs:range xsd:string .

dis:participationStartTime a owl:DatatypeProperty ;
    rdfs:label "participation start time" ;
    rdfs:domain dis:ActorParticipation ;
    rdfs:range xsd:dateTime .

dis:participationSupportedByEvidence a owl:ObjectProperty ;
    rdfs:label "supported by evidence" ;
    rdfs:comment "Many-to-many: a participation record may be supported by multiple Evidence instances (report, dataset, forensic trace)." ;
    rdfs:domain dis:ActorParticipation ;
    rdfs:range dis:Evidence .

dis:participationVisibility a owl:DatatypeProperty ;
    rdfs:label "visibility" ;
    rdfs:comment "Controlled vocabulary: Overt | Covert | Concealed | FalselyAttributed | Unknown. Do not treat as an actor subtype." ;
    rdfs:domain dis:ActorParticipation ;
    rdfs:range xsd:string .

dis:postingFrequencyMean a owl:DatatypeProperty ;
    rdfs:label "posting frequency mean" ;
    rdfs:comment "Mean number of posts per hour over the observation window." ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:float .

dis:profileAttributedToCampaign a owl:ObjectProperty ;
    rdfs:label "profile attributed to campaign" ;
    rdfs:domain dis:ThreatActorProfile ;
    rdfs:range dis:Campaign .

dis:profileEmploysTechnique a owl:ObjectProperty ;
    rdfs:label "profile employs technique" ;
    rdfs:comment "Techniques historically attributed to this threat actor profile." ;
    rdfs:domain dis:ThreatActorProfile ;
    rdfs:range disarm:Technique .

dis:profileImageHash a owl:DatatypeProperty ;
    rdfs:label "profile image hash" ;
    rdfs:comment "Perceptual hash of the profile image for stolen-image detection." ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:string .

dis:profileNameChangeCount a owl:DatatypeProperty ;
    rdfs:label "profile name change count" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:integer .

dis:providesContentToActor a owl:ObjectProperty ;
    rdfs:label "provides content to" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:providesInfrastructureToActor a owl:ObjectProperty ;
    rdfs:label "provides infrastructure to" ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:proxyForActor a owl:ObjectProperty ;
    rdfs:label "proxy for" ;
    rdfs:comment "Acts with meaningful dependence while preserving some deniability or separation, per the Hybrid CoE proxy/affiliate/auxiliary/surrogate model. Inverse: dis:actorHasProxy." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:relationshipConfidence a owl:DatatypeProperty ;
    rdfs:label "relationship confidence" ;
    rdfs:domain dis:ActorRelationship ;
    rdfs:range xsd:float .

dis:relationshipEndTime a owl:DatatypeProperty ;
    rdfs:label "relationship end time" ;
    rdfs:domain dis:ActorRelationship ;
    rdfs:range xsd:dateTime .

dis:relationshipInvolvesAudience a owl:ObjectProperty ;
    rdfs:label "involves audience" ;
    rdfs:domain dis:AudienceRelationship ;
    rdfs:range dis:AudienceSegment .

dis:relationshipInvolvesCampaign a owl:ObjectProperty ;
    rdfs:label "involves campaign" ;
    rdfs:domain dis:AudienceRelationship ;
    rdfs:range dis:Campaign .

dis:relationshipInvolvesContent a owl:ObjectProperty ;
    rdfs:label "involves content" ;
    rdfs:domain dis:AudienceRelationship ;
    rdfs:range dis:ContentItem .

dis:relationshipSourceActor a owl:ObjectProperty ;
    rdfs:label "relationship source actor" ;
    rdfs:domain dis:ActorRelationship ;
    rdfs:range dis:Actor .

dis:relationshipStartTime a owl:DatatypeProperty ;
    rdfs:label "relationship start time" ;
    rdfs:domain dis:ActorRelationship ;
    rdfs:range xsd:dateTime .

dis:relationshipSupportedByEvidence a owl:ObjectProperty ;
    rdfs:label "relationship supported by evidence" ;
    rdfs:domain dis:ActorRelationship ;
    rdfs:range dis:Evidence .

dis:relationshipTargetActor a owl:ObjectProperty ;
    rdfs:label "relationship target actor" ;
    rdfs:domain dis:ActorRelationship ;
    rdfs:range dis:Actor .

dis:relationshipType a owl:DatatypeProperty ;
    rdfs:label "relationship type" ;
    rdfs:comment "Controlled vocabulary: Owns | Controls | Directs | Funds | Contracts | Supports | AffiliatedWith | AlignedWith | MemberOf | ActsOnBehalfOf | ProxyFor | Coordinates | ProvidesInfrastructureTo | ProvidesContentTo | AmplifiesContentOf | Monitors | Investigates | Regulates | Counters | StateSponsoredProxy | StateDirected | StateAffiliated | Auxiliary | Surrogate." ;
    rdfs:domain dis:ActorRelationship ;
    rdfs:range xsd:string .

dis:sharedInfrastructureWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "shares infrastructure with (actors)" ;
    rdfs:comment "Two actors use the same hosting, IP range, or domain registrar." ;
    rdfs:domain dis:Actor ;
    rdfs:range dis:Actor .

dis:sockpuppetCoordinatedWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "sockpuppet coordinated with" ;
    rdfs:domain dis:SockpuppetAccount ;
    rdfs:range dis:SockpuppetAccount .

dis:stateRelationshipType a owl:DatatypeProperty ;
    rdfs:label "state relationship type" ;
    rdfs:comment "Controlled vocabulary: StateOwned | StateDirected | StateAffiliated | StateSponsoredProxy | Independent | Unknown. A qualified, revisable property rather than an actor subclass, because the same actor may be state-directed in one context and independent in another." ;
    rdfs:domain dis:Actor ;
    rdfs:range xsd:string .

dis:targetIntendedEffect a owl:ObjectProperty ;
    rdfs:label "target intended effect" ;
    rdfs:domain dis:TargetingRelation ;
    rdfs:range dis:Objective .

dis:targetRelevantVulnerability a owl:ObjectProperty ;
    rdfs:label "target relevant vulnerability" ;
    rdfs:domain dis:TargetingRelation ;
    rdfs:range dis:Vulnerability .

dis:targetRole a owl:DatatypeProperty ;
    rdfs:label "target role" ;
    rdfs:comment "Controlled vocabulary: PrimaryTarget | SecondaryTarget | SymbolicTarget | ProxyTarget | InstitutionalTarget | DecisionProcessTarget." ;
    rdfs:domain dis:TargetingRelation ;
    rdfs:range xsd:string .

dis:targetSelectionCriteria a owl:DatatypeProperty ;
    rdfs:label "target selection criteria" ;
    rdfs:domain dis:TargetingRelation ;
    rdfs:range xsd:string .

dis:targetedEntity a owl:ObjectProperty ;
    rdfs:label "targeted entity" ;
    rdfs:comment "The entity being targeted. Practical range includes Actor, AudienceSegment, Institution, Infrastructure, Objective, or Activity/Process (e.g. an electoral process, judicial proceeding). Left broad by design rather than constrained to a union class." ;
    rdfs:domain dis:TargetingRelation ;
    rdfs:range dis:CogOpsEntity .

dis:targetingConfidence a owl:DatatypeProperty ;
    rdfs:label "targeting confidence" ;
    rdfs:domain dis:TargetingRelation ;
    rdfs:range xsd:float .

dis:targetingEndTime a owl:DatatypeProperty ;
    rdfs:label "targeting end time" ;
    rdfs:domain dis:TargetingRelation ;
    rdfs:range xsd:dateTime .

dis:targetingSource a owl:ObjectProperty ;
    rdfs:label "targeting source" ;
    rdfs:comment "The Actor, Campaign, or Activity conducting the targeting." ;
    rdfs:domain dis:TargetingRelation ;
    rdfs:range dis:CogOpsEntity .

dis:targetingStartTime a owl:DatatypeProperty ;
    rdfs:label "targeting start time" ;
    rdfs:domain dis:TargetingRelation ;
    rdfs:range xsd:dateTime .

dis:threatActorAliases a owl:DatatypeProperty ;
    rdfs:label "aliases" ;
    rdfs:comment "Semicolon-separated list of known aliases." ;
    rdfs:domain dis:ThreatActorProfile ;
    rdfs:range xsd:string .

dis:threatActorCountry a owl:DatatypeProperty ;
    rdfs:label "attributed country" ;
    rdfs:comment "ISO 3166-1 alpha-2 code of the attributed nation-state." ;
    rdfs:domain dis:ThreatActorProfile ;
    rdfs:range xsd:string .

dis:threatActorFirstSeenAt a owl:DatatypeProperty ;
    rdfs:label "first seen at" ;
    rdfs:domain dis:ThreatActorProfile ;
    rdfs:range xsd:dateTime .

dis:threatActorMitreGroupId a owl:DatatypeProperty ;
    rdfs:label "MITRE ATT&CK Group ID" ;
    rdfs:comment "MITRE ATT&CK Group identifier (e.g., 'G0034') for cross-platform alignment." ;
    rdfs:domain dis:ThreatActorProfile ;
    rdfs:range xsd:string .

dis:threatActorMotivation a owl:DatatypeProperty ;
    rdfs:label "motivation" ;
    rdfs:comment "Controlled vocabulary (STIX 2.1 motivation vocab): accidental | coercion | dominance | ideology | notoriety | organizational-gain | personal-gain | personal-satisfaction | revenge | unpredictable." ;
    rdfs:domain dis:ThreatActorProfile ;
    rdfs:range xsd:string .

dis:threatActorName a owl:DatatypeProperty ;
    rdfs:label "threat actor name" ;
    rdfs:comment "Common name or alias of the threat actor (e.g., 'Internet Research Agency', 'Secondary Infektion')." ;
    rdfs:domain dis:ThreatActorProfile ;
    rdfs:range xsd:string .

dis:threatActorProfileHasMotivation a owl:ObjectProperty ;
    rdfs:label "profile has motivation" ;
    rdfs:domain dis:ThreatActorProfile ;
    rdfs:range dis:Motivation .

dis:threatActorProfileId a owl:DatatypeProperty ;
    rdfs:label "profile ID" ;
    rdfs:domain dis:ThreatActorProfile ;
    rdfs:range xsd:string .

dis:threatActorSophistication a owl:DatatypeProperty ;
    rdfs:label "sophistication" ;
    rdfs:comment "Controlled vocabulary (STIX 2.1): none | minimal | intermediate | advanced | expert | innovator | strategic." ;
    rdfs:domain dis:ThreatActorProfile ;
    rdfs:range xsd:string .

dis:threatActorStixId a owl:DatatypeProperty ;
    rdfs:label "STIX ID" ;
    rdfs:comment "STIX 2.1 ThreatActor object ID." ;
    rdfs:domain dis:ThreatActorProfile ;
    rdfs:range xsd:string .

dis:threatActorTargetedSectors a owl:DatatypeProperty ;
    rdfs:label "targeted sectors" ;
    rdfs:comment "Semicolon-separated list of targeted sectors (e.g., 'government;media;civil-society')." ;
    rdfs:domain dis:ThreatActorProfile ;
    rdfs:range xsd:string .

dis:totalPostCount a owl:DatatypeProperty ;
    rdfs:label "total post count" ;
    rdfs:domain dis:Account ;
    rdfs:range xsd:integer .

dis:usesProxy a owl:ObjectProperty ;
    rdfs:label "uses proxy" ;
    rdfs:domain dis:Account ;
    rdfs:range dis:Infrastructure .

# ===========================================================================
#  Module C - Operations
# ===========================================================================

dis:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:comment "An intentional operational action within or in association with a Campaign: for example persona creation, content production, seeding or coordinated amplification. Defender-side analytical or response actions can also be represented as activities and situated in the response workflow via responseWorkflowStage." ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module C - Operations (domain entity or relation)" .

dis:AmplificationTechnique a owl:Class ;
    rdfs:label "Amplification Technique" ;
    rdfs:comment "Techniques for priming and maximising exposure. Groups techniques of DISARM TA08 and TA17; the four categories are broad groupings, not an exhaustive partition of DISARM." ;
    rdfs:subClassOf dis:ManipulationTechnique ;
    dis:alignedDisarmTactic disarm:TA08,
        disarm:TA17 .

dis:AttitudinalObjective a owl:Class ;
    rdfs:label "Attitudinal Objective" ;
    rdfs:comment "Change attitudes or preferences toward persons, institutions, or policies." ;
    rdfs:subClassOf dis:Objective .

dis:BehaviouralObjective a owl:Class ;
    rdfs:label "Behavioural Objective" ;
    rdfs:comment "Drive specific actions: voting behaviour, protest participation, purchasing decisions, flight from institutions." ;
    rdfs:subClassOf dis:Objective .

dis:Campaign a owl:Class ;
    rdfs:label "Campaign" ;
    rdfs:comment """A coordinated effort grouping narratives, actors, channels,
and infrastructure toward a defined influence or manipulation objective.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module C - Operations (domain entity or relation)" .

dis:CoercionMotivation a owl:Class ;
    rdfs:label "Coercion Motivation" ;
    rdfs:comment "Forcing specific behaviour from targets through fear, psychological pressure, or manufactured social consensus." ;
    rdfs:subClassOf dis:Motivation .

dis:ConcealmentTechnique a owl:Class ;
    rdfs:label "Concealment Technique" ;
    rdfs:comment "Techniques for hiding origin, establishing false legitimacy and persisting undetected. Groups techniques of DISARM TA11 and TA16; the four categories are broad groupings, not an exhaustive partition of DISARM." ;
    rdfs:subClassOf dis:ManipulationTechnique ;
    dis:alignedDisarmTactic disarm:TA11,
        disarm:TA16 .

dis:DisseminationTechnique a owl:Class ;
    rdfs:label "Dissemination Technique" ;
    rdfs:comment "Techniques for selecting channels and delivering content. Groups techniques of DISARM TA07 and TA09; the four categories are broad groupings, not an exhaustive partition of DISARM." ;
    rdfs:subClassOf dis:ManipulationTechnique ;
    dis:alignedDisarmTactic disarm:TA07,
        disarm:TA09 .

dis:DomesticCohesionMotivation a owl:Class ;
    rdfs:label "Domestic Cohesion Motivation" ;
    rdfs:comment "A state or political actor uses disinformation to consolidate domestic support and suppress internal dissent." ;
    rdfs:subClassOf dis:Motivation .

dis:EconomicMotivation a owl:Class ;
    rdfs:label "Economic Motivation" ;
    rdfs:comment "Financial gain through clickbait farms, disinformation-as-a-service, market manipulation, or commercial competitive advantage." ;
    rdfs:subClassOf dis:Motivation .

dis:EconomicObjective a owl:Class ;
    rdfs:label "Economic Objective" ;
    rdfs:comment "Manipulate markets, erode economic confidence, or cause financial harm." ;
    rdfs:subClassOf dis:Objective .

dis:ElectoralObjective a owl:Class ;
    rdfs:label "Electoral Objective" ;
    rdfs:comment "Influence electoral outcomes through voter suppression, preference manipulation, or candidate discrediting." ;
    rdfs:subClassOf dis:Objective .

dis:GeopoliticalMotivation a owl:Class ;
    rdfs:label "Geopolitical Motivation" ;
    rdfs:comment "State interest in international power dynamics, territorial control, or influence in third countries." ;
    rdfs:subClassOf dis:Motivation .

dis:IdeologicalMotivation a owl:Class ;
    rdfs:label "Ideological Motivation" ;
    rdfs:comment "Promotion of a political, social, or religious worldview independent of direct state interest." ;
    rdfs:subClassOf dis:Motivation .

dis:Incident a owl:Class ;
    rdfs:label "Incident" ;
    rdfs:comment """A discrete, observed occurrence of influence-operation behaviour:
the execution of one or more DISARM TTPs in a bounded time window, directed
at a target audience or topic. The unit of analysis in the EEAS FIMI framework.
Analogous to STIX 2.1 IntrusionSet at the disinformation domain level.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module C - Operations (domain entity or relation)" .

dis:InformationalObjective a owl:Class ;
    rdfs:label "Informational Objective" ;
    rdfs:comment "Shape beliefs or knowledge states in target audiences." ;
    rdfs:subClassOf dis:Objective .

dis:Infrastructure a owl:Class ;
    rdfs:label "Infrastructure" ;
    rdfs:comment "A technical asset (domain, IP, hosting, CDN, VPN, botnet) used to operate campaigns." ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module C - Operations (domain entity or relation)" .

dis:InstitutionalObjective a owl:Class ;
    rdfs:label "Institutional Objective" ;
    rdfs:comment "Delegitimise, destabilise, or damage specific institutions (government agencies, media, courts, scientific bodies)." ;
    rdfs:subClassOf dis:Objective .

dis:ManipulationTechnique a owl:Class ;
    rdfs:label "Manipulation Technique" ;
    rdfs:comment """A specific technique used to deceive, mislead, or manipulate an audience,
following FIMI / DISARM / AMITT taxonomy categories.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module C - Operations (domain entity or relation)" .

dis:MilitaryObjective a owl:Class ;
    rdfs:label "Military Objective" ;
    rdfs:comment "Degrade military morale, cohesion, or operational effectiveness through cognitive means." ;
    rdfs:subClassOf dis:Objective .

dis:Motivation a owl:Class ;
    rdfs:label "Motivation" ;
    rdfs:comment """The underlying drivers explaining why a threat actor engages in
disinformation operations — the 'why' behind the 'what' (Objectives).
Motivation is a stable dispositional attribute of actors; it is more
fundamental than Objectives (which vary per campaign) and more abstract
than TTPs (which vary per incident). Aligned with the STIX 2.1 ThreatActor
motivation open vocabulary.""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module C - Operations (domain entity or relation)" .

dis:NotorietyMotivation a owl:Class ;
    rdfs:label "Notoriety Motivation" ;
    rdfs:comment "Attention-seeking, disruption for its own sake, or building online notoriety without a specific political agenda." ;
    rdfs:subClassOf dis:Motivation .

dis:Objective a owl:Class ;
    rdfs:label "Objective" ;
    rdfs:comment """The specific, measurable, time-bound goal that an adversary actor pursues
through a campaign or incident. Objectives are 'what' the actor tries to achieve
operationally — distinct from Motivation (which is 'why' the actor acts at all).
Maps to DISARM TA01 (Plan Strategy) and TA02 (Plan Objectives).""" ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module C - Operations (domain entity or relation)" .

dis:PersonalGainMotivation a owl:Class ;
    rdfs:label "Personal Gain Motivation" ;
    rdfs:comment "Reputational enhancement, narcissistic attention-seeking, or personal advantage for an individual actor." ;
    rdfs:subClassOf dis:Motivation .

dis:PolarisationObjective a owl:Class ;
    rdfs:label "Polarisation Objective" ;
    rdfs:comment "Amplify societal divisions without a specific directional agenda — the goal is instability and incoherence, not a particular political outcome." ;
    rdfs:subClassOf dis:Objective .

dis:RevengeMotivation a owl:Class ;
    rdfs:label "Revenge Motivation" ;
    rdfs:comment "Grievance-driven action against a specific target — individual, organisation, or state." ;
    rdfs:subClassOf dis:Motivation .

dis:TargetingTechnique a owl:Class ;
    rdfs:label "Targeting Technique" ;
    rdfs:comment "Techniques for analysing and microtargeting audiences. Groups techniques of DISARM TA05 and TA13; the four categories are broad groupings, not an exhaustive partition of DISARM." ;
    rdfs:subClassOf dis:ManipulationTechnique ;
    dis:alignedDisarmTactic disarm:TA05,
        disarm:TA13 .

dis:TemporalPattern a owl:Class ;
    rdfs:label "Temporal Pattern" ;
    rdfs:comment "A recurring posting rhythm, surge window, or sleep/wake cycle observed for an actor or cluster." ;
    rdfs:subClassOf dis:CogOpsEntity ;
    dis:belongsToModule "Module C - Operations (domain entity or relation)" .

